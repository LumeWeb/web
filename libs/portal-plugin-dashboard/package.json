{
  "name": "@lumeweb/portal-plugin-dashboard",
  "version": "0.1.5",
  "type": "module",
  "files": [
    "lib-dist",
    "package.json"
  ],
  "main": "lib-dist/index.js",
  "types": "lib-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/esm/index.d.ts",
      "import": "./lib-dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
