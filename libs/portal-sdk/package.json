{
  "name": "@lumeweb/portal-sdk",
  "version": "0.1.5",
  "type": "module",
  "description": "",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./openapi": {
      "types": "./dist/esm/openapi.d.ts",
      "import": "./dist/esm/openapi.js",
      "require": "./dist/cjs/openapi.cjs"
    },
    "./mocks": {
      "types": "./dist/esm/account/mocks.d.ts",
      "import": "./dist/esm/account/mocks.js",
      "require": "./dist/cjs/account/mocks.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "orval": "orval",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lumeweb/query-builder": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@lumeweb/tsdown-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.9",
    "msw": "catalog:",
    "orval": "catalog:",
    "tsdown": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
