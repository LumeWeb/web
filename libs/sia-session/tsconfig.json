{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@lumeweb/sia-session": ["./src/index.ts"],
      "@lumeweb/sia-session/abort": ["./src/abort.ts"]
    },
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.mjs", "vitest*.ts"],
  "exclude": ["tests/types"]
}
