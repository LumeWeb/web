{
  "name": "@lumeweb/portal-framework-core",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./vite": {
      "types": "./dist/esm/vite/index.d.ts",
      "import": "./dist/esm/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --browser",
    "test:browser:watch": "vitest --browser",
    "test:browser:ui": "vitest --browser --ui"
  },
  "dependencies": {
    "@lumeweb/portal-framework-ui-core": "workspace:*",
    "@lumeweb/portal-sdk": "workspace:*",
    "bin-pack": "^1.0.2"
  },
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "express": "^4.22.1",
    "lucide-react": "catalog:",
    "memoizee": "^0.4.17",
    "node-fetch": "^3.3.2",
    "react-error-boundary": "^6.1.0",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@module-federation/enhanced": "^0.21.6 || ^0.23.0 || ^0.24.0",
    "@refinedev/react-router": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "lucide-react": "catalog:",
    "memoizee": "^0.4.17",
    "react": "catalog:",
    "react-error-boundary": "^6.0.0",
    "react-is": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
