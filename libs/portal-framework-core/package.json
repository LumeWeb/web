{
  "name": "@lumeweb/portal-framework-core",
  "version": "0.1.7",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./vite": {
      "types": "./dist/esm/vite/index.d.ts",
      "import": "./dist/esm/vite/index.js"
    },
    "./schemas/*": "./dist/esm/schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --browser",
    "test:browser:watch": "vitest --browser",
    "test:browser:ui": "vitest --browser --ui"
  },
  "dependencies": {
    "@lumeweb/portal-framework-ui-core": "workspace:*",
    "@lumeweb/portal-sdk": "workspace:*",
    "ajv": "^8.20.0",
    "bin-pack": "^1.0.2",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/express": "^5.0.6",
    "@types/react": "catalog:",
    "@vitejs/devtools": "^0.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "express": "^5.2.1",
    "lucide-react": "catalog:",
    "memoizee": "^0.4.17",
    "node-fetch": "^3.3.2",
    "react-error-boundary": "^6.1.2",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@module-federation/enhanced": "catalog:",
    "@refinedev/react-router": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "lucide-react": "catalog:",
    "memoizee": "^0.4.17",
    "react": "catalog:",
    "react-error-boundary": "^6.0.0",
    "react-is": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
