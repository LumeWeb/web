{
  "name": "@lumeweb/portal-framework-core",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./vite": {
      "types": "./dist/esm/vite/index.d.ts",
      "import": "./dist/esm/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --browser",
    "test:browser:watch": "vitest --browser",
    "test:browser:ui": "vitest --browser --ui"
  },
  "dependencies": {
    "@lumeweb/portal-sdk": "workspace:*",
    "bin-pack": "^1.0.2"
  },
  "devDependencies": {
    "esbuild-fix-imports-plugin": "^1.0.14",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "memoizee": "^0.4.17",
    "node-fetch": "^3.3.2",
    "react-error-boundary": "^6.0.0",
    "tsdown": "^0.12.7"
  },
  "peerDependencies": {
    "@module-federation/bridge-react": "^0.14.0",
    "@module-federation/enhanced": "^0.14.0",
    "@refinedev/react-router": "^1.0.1",
    "@t3-oss/env-core": "^0.12.0",
    "lucide-react": "^0.511.0",
    "memoizee": "^0.4.17",
    "react": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-router": "^7",
    "vite-tsconfig-paths": "^4.3.2",
    "zod": "3.24.2",
    "react-is": "^19.1.1"
  }
}
