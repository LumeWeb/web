{
  "name": "@lumeweb/pinner",
  "version": "0.1.18",
  "type": "module",
  "files": [
    "dist",
    "public",
    "package.json"
  ],
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./mocks": {
      "types": "./dist/esm/api/mocks.d.ts",
      "import": "./dist/esm/api/mocks.js"
    },
    "./adapters/pinata": {
      "types": "./dist/esm/adapters/pinata/index.d.ts",
      "import": "./dist/esm/adapters/pinata/index.js"
    },
    "./blockstore": {
      "types": "./dist/esm/blockstore/index.d.ts",
      "browser": {
        "types": "./dist/esm/blockstore/unstorage.browser.d.ts",
        "import": "./dist/esm/blockstore/unstorage.browser.js"
      },
      "node": {
        "types": "./dist/esm/blockstore/unstorage.node.d.ts",
        "import": "./dist/esm/blockstore/unstorage.node.js"
      },
      "default": {
        "types": "./dist/esm/blockstore/unstorage.node.d.ts",
        "import": "./dist/esm/blockstore/unstorage.node.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "coverage": "vitest --coverage",
    "orval": "orval"
  },
  "dependencies": {
    "@helia/car": "catalog:",
    "@helia/http": "catalog:",
    "@helia/unixfs": "catalog:",
    "helia": "catalog:",
    "@ipfs-shipyard/pinning-service-client": "catalog:",
    "@ipld/car": "catalog:",
    "@lumeweb/portal-sdk": "workspace:*",
    "@lumeweb/query-builder": "workspace:*",
    "@lumeweb/uppy-post-upload": "workspace:*",
    "@uppy/core": "catalog:",
    "@uppy/tus": "catalog:",
    "blockstore-core": "catalog:",
    "blockstore-idb": "catalog:",
    "datastore-idb": "catalog:",
    "idb-keyval": "^6.2.6",
    "interface-blockstore": "^7.0.1",
    "interface-datastore": "^10.0.1",
    "interface-store": "^8.0.0",
    "ipaddr.js": "^2.4.0",
    "jwt-decode": "^4.0.0",
    "ky": "catalog:",
    "multiformats": "catalog:",
    "nanoevents": "catalog:",
    "p-defer": "^4.0.1",
    "progress-events": "catalog:",
    "tus-js-client": "4.3.1",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@lumeweb/tsdown-config": "workspace:*",
    "@mswjs/interceptors": "catalog:",
    "@types/uuid": "^11.0.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/ui": "4.1.5",
    "datastore-core": "catalog:",
    "happy-dom": "catalog:",
    "msw": "catalog:",
    "orval": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "tus-node-server": "^0.9.0",
    "typescript": "catalog:",
    "uuid": "^14.0.1",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
