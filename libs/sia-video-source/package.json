{
  "name": "@lumeweb/sia-video-source",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js"
    },
    "./worker": {
      "types": "./dist/esm/worker.d.ts",
      "import": "./dist/esm/worker.js"
    },
    "./worker/setup": {
      "types": "./dist/esm/worker-setup.d.ts",
      "import": "./dist/esm/worker-setup.js"
    },
    "./sia": {
      "types": "./dist/esm/sia-stream-service.d.ts",
      "import": "./dist/esm/sia-stream-service.js"
    },
    "./sia/zustand": {
      "types": "./dist/esm/sia-stream-zustand.d.ts",
      "import": "./dist/esm/sia-stream-zustand.js"
    },
    "./testing": {
      "types": "./dist/esm/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js"
    },
    "./testing/player": {
      "types": "./dist/esm/testing/player.d.ts",
      "import": "./dist/esm/testing/player.js"
    },
    "./testing/reader": {
      "types": "./dist/esm/testing/reader.d.ts",
      "import": "./dist/esm/testing/reader.js"
    },
    "./testing/worker": {
      "types": "./dist/esm/testing/worker.d.ts",
      "import": "./dist/esm/testing/worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project 'playback*' --no-file-parallelism",
    "test:browser:watch": "vitest --project 'playback*'",
    "test:browser:ui": "vitest --project 'playback*' --ui",
    "test:e2e:mock": "pnpm --filter @lumeweb/tsdown-config build:config && pnpm --filter @lumeweb/sia-testing build && playwright test --config playwright.mock.config.ts",
    "test:e2e:mock:collect": "pnpm --filter @lumeweb/tsdown-config build:config && pnpm --filter @lumeweb/sia-testing build && playwright test --config playwright.mock.config.ts --list",
    "test:e2e:sdk": "pnpm --filter @lumeweb/tsdown-config build:config && playwright test --config playwright.contract.config.ts",
    "test:e2e:sdk:build": "pnpm --filter @lumeweb/tsdown-config build:config && pnpm build && vite build --config tests/contract/vite.config.ts",
    "test:e2e:sdk:collect": "playwright test --config playwright.contract.config.ts --list",
    "test:e2e:sdk:offline": "node --test tests/contract/*.test.ts"
  },
  "dependencies": {
    "@lumeweb/sia-session": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@siafoundation/sia-storage": "0.2.0",
    "mediabunny": "1.58.0",
    "robot3": "^1.2.0"
  },
  "peerDependencies": {
    "@lumeweb/sia-testing": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@videojs/core": "10.0.0-beta.32",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "10.0.0-beta.32",
    "@videojs/spf": "10.0.0-beta.32",
    "@videojs/store": "10.0.0-beta.32",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lumeweb/sia-testing": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@videojs/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@videojs/core": "10.0.0-beta.32",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "10.0.0-beta.32",
    "@videojs/spf": "10.0.0-beta.32",
    "@videojs/store": "10.0.0-beta.32",
    "@vitest/browser-playwright": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "^1.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@lumeweb/sia-testing": "workspace:*",
    "@playwright/test": "^1.61.1",
    "vite": "catalog:framework"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
