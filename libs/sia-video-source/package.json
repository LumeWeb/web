{
  "name": "@lumeweb/sia-video-source",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js"
    },
    "./worker": {
      "types": "./dist/esm/worker.d.ts",
      "import": "./dist/esm/worker.js"
    },
    "./sia": {
      "types": "./dist/esm/sia-stream-service.d.ts",
      "import": "./dist/esm/sia-stream-service.js"
    },
    "./sia/zustand": {
      "types": "./dist/esm/sia-stream-zustand.d.ts",
      "import": "./dist/esm/sia-stream-zustand.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project 'playback*'",
    "test:browser:watch": "vitest --project 'playback*'",
    "test:browser:ui": "vitest --project 'playback*' --ui",
    "test:e2e:collect": "playwright test --config playwright.e2e.config.ts --list",
    "test:e2e:live": "sia-testing-e2e --cwd \"$PWD\" -- playwright test --config playwright.e2e.config.ts",
    "test:e2e:build": "vite build --config tests/e2e/vite.config.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@siafoundation/sia-storage": "^0.1.4",
    "mediabunny": "1.58.0",
    "robot3": "^1.2.0"
  },
  "peerDependencies": {
    "@videojs/core": "10.0.0-beta.32",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "10.0.0-beta.32",
    "@videojs/spf": "10.0.0-beta.32",
    "@videojs/store": "10.0.0-beta.32",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@videojs/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@videojs/core": "10.0.0-beta.32",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "10.0.0-beta.32",
    "@videojs/spf": "10.0.0-beta.32",
    "@videojs/store": "10.0.0-beta.32",
    "@vitest/browser-playwright": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "^1.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@lumeweb/sia-testing": "workspace:*",
    "@playwright/test": "^1.61.1",
    "vite": "catalog:framework"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
