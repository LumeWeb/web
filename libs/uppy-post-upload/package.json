{
  "name": "@lumeweb/uppy-post-upload",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "description": "Plain and simple classic HTML multipart form uploads with Uppy, as well as uploads using the HTTP PUT method.",
  "author": "Derrick Hammer",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "file uploader",
    "xhr",
    "xhr upload",
    "XMLHttpRequest",
    "ajax",
    "fetch",
    "uppy",
    "uppy-plugin"
  ],
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "@mswjs/interceptors": "catalog:",
    "@uppy/core": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "^27.4.0",
    "msw": "catalog:",
    "nock": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@uppy/core": "catalog:"
  },
  "dependencies": {
    "@uppy/companion-client": "^5.1.1",
    "@uppy/utils": "^7.1.5",
    "ky": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
