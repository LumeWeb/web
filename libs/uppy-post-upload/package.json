{
  "name": "@lumeweb/uppy-post-upload",
  "version": "0.0.0",
  "type": "module",
  "description": "Plain and simple classic HTML multipart form uploads with Uppy, as well as uploads using the HTTP PUT method.",
  "author": "Derrick Hammer",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "file uploader",
    "xhr",
    "xhr upload",
    "XMLHttpRequest",
    "ajax",
    "fetch",
    "uppy",
    "uppy-plugin"
  ],
  "devDependencies": {
    "@mswjs/interceptors": "^0.40.0",
    "@uppy/core": "^5.2.0",
    "@vitest/browser-playwright": "^4.0.16",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "nock": "^14.0.10",
    "playwright": "^1.57.0",
    "tsdown": "0.19.0-beta.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@uppy/core": "^5.2.0"
  },
  "dependencies": {
    "@uppy/companion-client": "^5.1.1",
    "@uppy/utils": "^7.1.5",
    "ky": "^1.14.2"
  }
}
