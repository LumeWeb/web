/** Published observation types retain application sessions and readonly command bindings. */
import { createElement } from "react";
import type { SiaAccess } from "@lumeweb/sia-app-access";
import {
  createSiaAccessContext,
  SiaAccessView,
  useSiaAccess,
  useSiaAccessSelector,
} from "@lumeweb/sia-app-access/react";
import { createSiaAccessStore } from "@lumeweb/sia-app-access/zustand";

interface Destination {
  write(content: Uint8Array): Promise<string>;
}
const context = createSiaAccessContext<Destination>();
export function useDestination(access: SiaAccess<Destination>): void {
  const binding = useSiaAccess(access);
  const contextual = context.useAccess();
  const key: Promise<string> = contextual.commands.withSession((destination) =>
    destination.write(new Uint8Array()),
  );
  const phase: string = useSiaAccessSelector(
    access,
    (snapshot) => snapshot.state.phase,
  );
  const store = createSiaAccessStore(access);
  void key;
  void phase;
  // @ts-expect-error Observation does not own controller disposal.
  binding.commands.dispose();
  // @ts-expect-error Command bindings are readonly.
  binding.commands.cancel = () => undefined;
  // @ts-expect-error The store does not own mutable controller state.
  store.setState({});
  void createElement(SiaAccessView<Destination>, {
    access,
    children: () => null,
  });
  void createElement(context.Provider, { access });
}

import type {
  SiaAccessInteractions,
  AccessInteractionSnapshot,
  SubmitRecoveryPhraseResult,
} from "@lumeweb/sia-app-access";
import {
  useSiaApproval,
  useSiaRecoveryPhrase,
  useSiaSaveRecovery,
} from "@lumeweb/sia-app-access/react";

export function useTasks(
  access: SiaAccessInteractions<Destination>,
  legacy: SiaAccess<Destination>,
): void {
  const snapshot: AccessInteractionSnapshot = access.getSnapshot();
  const task = useSiaRecoveryPhrase(access, { serverSnapshot: snapshot });
  const outcome: Promise<SubmitRecoveryPhraseResult> | undefined =
    task?.submit("application input");
  void outcome;
  void task?.generate();
  void context.useApproval();
  void context.useRecoveryPhrase();
  void context.useSaveRecovery();
  void useSiaApproval(access)?.url;
  void useSiaSaveRecovery(access)?.retrySave();
  // @ts-expect-error The application must supply its input.
  void task?.submit();
  // @ts-expect-error Task models do not own application form values.
  void task?.value;
  // @ts-expect-error Task hooks need truthful interaction metadata.
  useSiaRecoveryPhrase(legacy);
}
