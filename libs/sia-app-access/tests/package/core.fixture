/** The installed archive provides generic contracts without ambient framework types. */
import {
  createMemoryCredentialStore,
  createSiaAccess,
  AccessOutcome,
  CredentialConfirmation,
} from "@lumeweb/sia-app-access";
import type {
  SiaAccess,
  SubmitRecoveryPhraseResult,
  MemoryCredentialStore,
  SiaAccessAdapter,
  SiaAccessInteractions,
} from "@lumeweb/sia-app-access";

import { toRecoveryPhraseFieldError } from "@lumeweb/sia-app-access/react-hook-form";
export function inspectFieldErrorWithoutFormPeers(): string | undefined {
  return toRecoveryPhraseFieldError(
    { kind: AccessOutcome.PhraseMismatch },
    {
      invalidPhrase: "Invalid input",
      phraseMismatch: "Different account",
    },
  )?.message;
}

const store: MemoryCredentialStore = createMemoryCredentialStore();
void store;
declare const adapter: SiaAccessAdapter<{ readonly id: string }>;
const created = createSiaAccess({
  adapter,
  application: {
    appId: "a".repeat(64),
    name: "Types",
    description: "",
    serviceUrl: "https://app.example/",
  },
  indexerUrl: "https://indexer.example/",
});
const inferred: SiaAccessInteractions<{ readonly id: string }> = created;
void inferred;
// @ts-expect-error Factory inference must not admit unrelated session methods.
created.withSession((session) => session.missing);
declare const access: SiaAccess<{ readonly id: string }>;
const borrowed: Promise<string> = access.withSession((session) => session.id);
void borrowed;
// @ts-expect-error Session inference must not become any.
access.withSession((session) => session.missing);
declare const result: SubmitRecoveryPhraseResult;
if (result.kind === AccessOutcome.Ready) {
  const confirmed: CredentialConfirmation.Confirmed = result.credentials;
  void confirmed;
}
