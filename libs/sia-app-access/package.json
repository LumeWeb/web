{
  "name": "@lumeweb/sia-app-access",
  "version": "0.0.0",
  "description": "Scoped Sia credentials and framework-free access contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web",
    "directory": "libs/sia-app-access"
  },
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sia": {
      "types": "./dist/sia.d.ts",
      "import": "./dist/sia.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./unstorage": {
      "types": "./dist/unstorage.d.ts",
      "import": "./dist/unstorage.js"
    },
    "./zustand": {
      "types": "./dist/zustand.d.ts",
      "import": "./dist/zustand.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "import": "./dist/react-hook-form.js"
    }
  },
  "scripts": {
    "example:react": "vite examples/react-onboarding",
    "example:react:build": "vite build examples/react-onboarding",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests examples playwright.config.ts vite.config.ts --ignore-pattern 'tests/types/**' && oxlint --react-plugin --allow all --deny react/rules-of-hooks --deny react/exhaustive-deps --deny-warnings src tests examples --ignore-pattern 'tests/types/**' && stylelint \"examples/**/*.scss\" --max-warnings 0",
    "format": "prettier --write . && prettier --parser typescript --write 'tests/package/*.fixture'",
    "format:check": "prettier --check . && prettier --parser typescript --check 'tests/package/*.fixture'",
    "test": "node --import tsx --test 'tests/*.test.ts'",
    "test:offline": "node --import tsx --test 'tests/offline/*.test.ts'",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:build": "vite build",
    "test:contracts": "pnpm run build && tsc -p tsconfig.contracts.json && tsc -p tsconfig.sdk-contracts.json && tsc -p tsconfig.react-contracts.json",
    "test:package": "pnpm run build && node --import tsx --test 'tests/package/*.test.ts'"
  },
  "dependencies": {
    "@lumeweb/sia-session": "workspace:*",
    "@noble/hashes": "2.4.0",
    "robot3": "1.4.0"
  },
  "devDependencies": {
    "@lumeweb/sia-testing": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@siafoundation/sia-storage": "0.2.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "msw": "catalog:",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "sass": "1.108.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.0",
    "unstorage": "1.17.5",
    "typescript": "catalog:",
    "vite": "catalog:framework",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@siafoundation/sia-storage": "0.2.0",
    "react": "^19.0.0",
    "unstorage": "^1.17.5",
    "zustand": "^5.0.14"
  },
  "peerDependenciesMeta": {
    "@siafoundation/sia-storage": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "unstorage": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  }
}
