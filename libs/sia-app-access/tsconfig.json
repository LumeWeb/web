{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "module": "NodeNext",
    "jsx": "react-jsx",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*.ts", "./src/*.tsx"],
      "@lumeweb/sia-app-access": ["./src/index.ts"],
      "@lumeweb/sia-app-access/react": ["./src/react.ts"],
      "@lumeweb/sia-app-access/react-hook-form": ["./src/react-hook-form.ts"],
      "@lumeweb/sia-app-access/sia": ["./src/sia.ts"],
      "@lumeweb/sia-app-access/zustand": ["./src/zustand.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["tests/types"]
}
