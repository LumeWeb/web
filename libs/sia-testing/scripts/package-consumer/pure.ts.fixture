/** Checks scoped run and reader declarations without MSW or Playwright installed. */
import { createMockSia, bytesFixture } from "@lumeweb/sia-testing/mock";
import { createMockApplication, createMockOwnerShares, createMockReader } from "@lumeweb/sia-testing/client";
import type { ApplicationShares, ApplicationShareRef, ApplicationShareTarget, ShareInspection, ShareOperation } from "@lumeweb/sia-testing/client";
import type { MockShareGrant } from "@lumeweb/sia-testing/mock";
import { startMockServer } from "@lumeweb/sia-testing/http";
import { withSiaRun } from "@lumeweb/sia-testing/node";
export const mock = createMockSia();
const app = { description: "Packed fixture", id: "a".repeat(64), name: "Packed", serviceUrl: "https://example.invalid" };
export async function typedConsumer() {
  return withSiaRun({ backend: { app, kind: "mock" } }, async (run) => {
    const file = await bytesFixture({ bytes: Uint8Array.of(1), name: "video" });
    const object = await run.objects.upload({ file, metadata: new Uint8Array() });
    const server = await startMockServer(run.mock);
    const binding = server.connection({ access: run.ownerAccess, as: run.mock.actor("typed") });
    const reader = createMockReader(binding, binding.credential);
    const owner = createMockOwnerShares(binding, binding.credential);
    await run.shares.create({ objects: [object], description: "Typed" });
    const ref = (await owner.list({ offset: 0, limit: 1 })).items[0]!.ref;
    const logicalBytes: number = (await owner.detail(ref)).statistics.logicalBytes;
    const contents = await owner.objects(ref, { offset: 0, limit: 1 });
    const objectSize: number = contents.items[0]!.sizeBytes;
    await owner.close();
    const size: number = (await reader.object(object.id)).sizeBytes;
    await reader.close();
    const writer = createMockApplication(binding, binding.credential);
    const pending = await writer.upload({ file, metadata: new Uint8Array() });
    // @ts-expect-error Application uploads require explicit metadata.
    void writer.upload({ file });
    // @ts-expect-error Managed uploads require explicit metadata.
    void run.objects.upload({ file });
    const staged: "missing" | "uploaded" | "pinned" = await writer.inspect(pending);
    await writer.pin(pending);
    await writer.pin(pending, { signal: new AbortController().signal });
    await writer.pin(pending, { metadata: Uint8Array.of(1) });
    await writer.pin(pending, { metadata: undefined });
    await writer.pin(pending, { metadata: new Uint8Array() });
    const cursor = (await writer.events({cursor:null,limit:1})).nextCursor;
    await writer.events({cursor,limit:1});
    // @ts-expect-error fixture handles do not authorize application writes
    await writer.pin(object);
    // @ts-expect-error application handles do not authorize fixture mutations
    await run.objects.delete(pending);
    await writer.delete(pending);
    await writer.close();
    void staged;
    await server.close();
    return size + logicalBytes + objectSize;
  });
}

export async function typedShareConsumer(run: import("@lumeweb/sia-testing/mock").MockRun) {
  const actor = run.mock.actor("share editor");
  const share = await run.shares.create({ objects: [] });
  const operations: readonly ShareOperation[] = ["add", "remove", "end"];
  const grant: MockShareGrant = await run.shares.grant(share, { as: actor, label: "list", operations, expiresAt: new Date(Date.now() + 10000) });
  const server = await startMockServer(run.mock);
  try {
    const connection = server.connection({ access: run.ownerAccess, as: actor, shareGrants: [grant] });
    const writer = createMockApplication(connection, connection.credential);
    const shares: ApplicationShares = writer.shares;
    const target: ApplicationShareTarget = (await shares.targets())[0]!;
    const ref: ApplicationShareRef = target.ref;
    const inspection: ShareInspection = await shares.inspect(ref, null);
    await shares.end(ref);
    // @ts-expect-error Driver grants are not application refs.
    await shares.end(grant);
    await writer.close();
    await run.shares.revokeGrant(grant);
    return inspection;
  } finally { await server.close(); }
}

export async function typedPackedConsumer(run: import("@lumeweb/sia-testing/mock").MockRun) {
  const sdk = run.mock.packedSdk({ access: run.ownerAccess, as: run.mock.actor("packed"), platform: "browser", maxBytes: 8, maxObjects: 1 });
  const packed = sdk.uploadPacked({ dataShards: 1, parityShards: 1 });
  const bytes: number = await packed.add(new ReadableStream<Uint8Array>());
  // @ts-expect-error Browser counts are not Node bigint counts.
  const wrongCount: bigint = bytes;
  const [object] = await packed.finalize();
  if (object) {
    object.updateMetadata(Uint8Array.of(1));
    await sdk.updateObjectMetadata(object);
    await sdk.pinObject(object);
    const result: void = object.seal(sdk.appKey());
    // @ts-expect-error Read records cannot grant packed mutation authority.
    await sdk.pinObject({ id: object.id(), metadata: new Uint8Array(), sizeBytes: 1 });
    // @ts-expect-error IDs cannot grant seal authority.
    object.seal({ id: "key" });
    void result;
  }
  await sdk.close();
  return wrongCount;
}
