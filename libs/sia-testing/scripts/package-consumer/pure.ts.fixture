/** Compiles in the copied consumer so workspace declarations cannot hide missing package types. */
import { createAccount } from "@lumeweb/sia-testing/fixtures";
import { createIndexdHttpServer } from "@lumeweb/sia-testing/http";
import {
  createIndexdModel,
  type IndexdModel,
} from "@lumeweb/sia-testing/model";

export const model: IndexdModel = createIndexdModel({ quotaBytes: 100 });
const count: number = model.snapshot().accounts.length;
const server = createIndexdHttpServer({ model });
const listening: boolean = server.server.listening;
const ready: boolean = createAccount().ready;
void [ready, count, listening];

import { createMockNetwork, createMockObject, createRemoteMockSdk } from "@lumeweb/sia-testing/sdk";
const mock = createMockNetwork({ model });
const mockSize: number = createMockObject("video", 4).size();
const remote = createRemoteMockSdk({ client: "reader", url: "http://127.0.0.1:1" });
void [mock, mockSize, remote];
