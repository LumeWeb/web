/** Runs scoped storage without either optional test peer. */
import assert from "node:assert/strict";
import { createMockSia, bytesFixture } from "@lumeweb/sia-testing/mock";
import { createMockApplication, createMockOwnerShares, createMockReader } from "@lumeweb/sia-testing/client";
import { startMockServer } from "@lumeweb/sia-testing/http";
import { withSiaRun } from "@lumeweb/sia-testing/node";
const app = { description: "Packed fixture", id: "a".repeat(64), name: "Packed", serviceUrl: "https://example.invalid" };
const mock = createMockSia();
try {
  await mock.run({ app }, async (run) => {
    const file = await bytesFixture({ bytes: Uint8Array.of(4, 5), name: "video" });
    const object = await run.objects.upload({ file, metadata: Uint8Array.of(6), name: file.name });
    const server = await startMockServer(mock);
    try {
      const actor = mock.actor("consumer");
      const share = await run.shares.create({ objects: [] });
      const grant = await run.shares.grant(share, { as: actor, label: "packed-list", operations: ["add", "remove", "end"] });
      const binding = server.connection({ access: run.ownerAccess, as: actor, shareGrants: [grant] });
      const writer = createMockApplication(binding, binding.credential);
      try {
        const pending = await writer.upload({file,name:file.name,metadata:new Uint8Array()});
        assert.equal(await writer.inspect(pending), "uploaded");
        await writer.pin(pending);
        assert.equal(await writer.inspect(pending), "pinned");
        const [target] = await writer.shares.targets();
        assert.equal(target.label, "packed-list");
        await writer.shares.add(target.ref, pending);
        assert.deepEqual(await writer.shares.inspect(target.ref, pending.id), { state: "active", contains: true });
        await writer.shares.remove(target.ref, pending.id);
        assert.deepEqual(await writer.shares.inspect(target.ref, pending.id), { state: "active", contains: false });
        await writer.shares.end(target.ref);
        assert.deepEqual(await writer.shares.inspect(target.ref, null), { state: "ended", contains: null });
        await run.shares.revokeGrant(grant);
        assert.deepEqual(await writer.shares.targets(), []);
        assert.deepEqual((await writer.events({cursor:null,limit:10})).events, []);
        await mock.publish({access:run.ownerAccess});
        assert.equal((await writer.events({cursor:null,limit:10})).events.length, 2);
        await writer.delete(pending);
        assert.equal(await writer.inspect(pending), "missing");
      } finally { await writer.close(); }
      const reader = createMockReader(binding, binding.credential);
      assert.deepEqual([...new Uint8Array(await new Response(await reader.download(await reader.object(object.id))).arrayBuffer())], [4, 5]);
      await reader.close();
      await run.shares.create({ objects: [object], description: "Packed owner" });
      const direct = mock.ownerShares({ access: run.ownerAccess, as: mock.actor("direct owner") });
      const owner = createMockOwnerShares(binding, binding.credential);
      try {
        assert.equal((await direct.list({ offset: 0, limit: 1 })).items[0].description, "Packed owner");
        const page = await owner.list({ offset: 0, limit: 1 });
        const ref = page.items[0].ref;
        assert.deepEqual((await owner.detail(ref)).statistics, { objectCount: 1, logicalBytes: 2 });
        assert.deepEqual((await owner.objects(ref, { offset: 0, limit: 1 })).items, [{ id: object.id, metadata: Uint8Array.of(6), sizeBytes: 2 }]);
      } finally { await owner.close(); await direct.close(); }
    } finally { await server.close(); }
  });
} finally { await mock.close(); }
assert.equal((await withSiaRun({ backend: { app, kind: "mock" } }, async () => "managed")).value, "managed");
for (const entry of ["", "/fixtures", "/model", "/sdk", "/msw/node"]) {
  await assert.rejects(import("@lumeweb/sia-testing" + entry), { code: "ERR_PACKAGE_PATH_NOT_EXPORTED" });
}
for (const [entry, peer] of [["msw", "msw"], ["playwright", "@playwright/test"]]) {
  await assert.rejects(import("@lumeweb/sia-testing/" + entry), (error) => error.code === "ERR_MODULE_NOT_FOUND" && error.message.includes(peer), entry + " must require the optional " + peer + " peer");
}
