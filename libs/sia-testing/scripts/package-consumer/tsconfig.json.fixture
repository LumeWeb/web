{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "files": ["pure.ts"]
}
