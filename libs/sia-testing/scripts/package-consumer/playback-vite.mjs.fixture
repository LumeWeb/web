#!/usr/bin/env node
/** Replaces server startup with a check that playback startup rebuilt its public import. */
import assert from "node:assert/strict";

const library = await import("@lumeweb/sia-video-source/sia");
assert.equal(
  typeof library.createSiaStreamService,
  "function",
  "Playback startup must replace the stale library export before serving the page",
);
