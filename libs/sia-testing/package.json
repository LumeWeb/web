{
  "name": "@lumeweb/sia-testing",
  "version": "0.1.0",
  "description": "Scoped fixtures and mock application ports for Sia playback tests",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./node": {
      "types": "./dist/esm/node.d.ts",
      "import": "./dist/esm/node.js"
    },
    "./mock": {
      "types": "./dist/esm/mock.d.ts",
      "import": "./dist/esm/mock.js"
    },
    "./client": {
      "types": "./dist/esm/client.d.ts",
      "import": "./dist/esm/client.js"
    },
    "./http": {
      "types": "./dist/esm/http.d.ts",
      "import": "./dist/esm/http.js"
    },
    "./msw": {
      "types": "./dist/esm/msw.d.ts",
      "import": "./dist/esm/msw.js"
    },
    "./playwright": {
      "types": "./dist/esm/playwright.d.ts",
      "import": "./dist/esm/playwright.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "lint": "oxlint src tests scripts",
    "test": "vitest run --project unit",
    "test:browser": "playwright test --config playwright.ci.config.ts && playwright test --config playwright.loopback.config.ts",
    "test:native:helpers": "vitest run --project native-helpers",
    "test:native:control": "vitest run --project native-control",
    "test:package": "pnpm run build && node scripts/check-package.mjs",
    "test:consumers": "node scripts/check-consumers.mjs",
    "test:mutation": "node scripts/mutation-regression.mjs"
  },
  "peerDependencies": {
    "@playwright/test": "^1.61.1",
    "@siafoundation/sia-storage": "0.1.4",
    "msw": "^2.14.6"
  },
  "peerDependenciesMeta": {
    "@siafoundation/sia-storage": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lumeweb/tsdown-config": "workspace:*",
    "@noble/hashes": "^2.0.1",
    "@playwright/test": "^1.61.1",
    "@siafoundation/sia-storage": "0.1.4",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:framework",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
