{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@lumeweb/sia-testing/mock": ["./src/mock.ts"],
      "@lumeweb/sia-testing/vitest": ["./src/vitest.ts"]
    },
    "lib": ["esnext", "dom"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["tests/sdk/native/**", "src/testing/live/agent.ts"]
}
