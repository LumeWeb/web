# Tunnel config for portal-app-shell (module-federation with plugins)
TUNNEL_MODE=multi
TUNNEL_APP_DIR=apps/portal-app-shell
TUNNEL_MAIN_APP_DIR=apps/portal-app-shell
TUNNEL_MAIN_HOST=dash
TUNNEL_MAIN_PORT=4173
TUNNEL_SERVER_CMD="pnpm serve"

# TUNNEL_PLUGINS can be defined here OR in root .env (preferred, gitignored).
# Root .env takes precedence. Use CLI --plugins for one-off overrides.
# Example: TUNNEL_PLUGINS="core,dashboard,admin,ipfs,lbry"

# Use "auto" to generate config from TUNNEL_PLUGINS, or specify JSON file path
TUNNEL_PLUGIN_CONFIG=auto
TUNNEL_PLUGINS_BASE_DIR=libs
