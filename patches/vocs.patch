+import * as Config from '../../../internal/config.js';
+/**
+ * CORS middleware for split frontend/backend deployments.
+ * When `backendUrl` is configured, this middleware adds the necessary CORS
+ * headers so the browser allows cross-origin API requests from the static
+ * frontend (e.g. served from IPFS). If `backendUrl` is not set, the middleware
+ * is a no-op.
+ */
+export const cors = () => {
+    return async (context, next) => {
+        const config = await Config.resolve({ server: true });
+        if (!config.backendUrl)
+            return next();
+        const origin = context.req.header('origin');
+        if (origin) {
+            context.header('Access-Control-Allow-Origin', origin);
+            context.header('Access-Control-Allow-Methods', 'GET, POST, DELETE, OPTIONS');
+            context.header('Access-Control-Allow-Headers', 'Content-Type, mcp-session-id');
+            context.header('Access-Control-Max-Age', '86400');
+        }
+        if (context.req.method === 'OPTIONS') {
+            return new Response(null, { status: 204 });
+        }
+        return next();
+    };
+};
+export default cors;
+//# sourceMappingURL=cors.js.map
