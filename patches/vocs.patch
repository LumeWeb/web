@@ -0,0 +1,24 @@
+import * as Config from '../../../internal/config.js';
+/**
+ * CORS middleware for split frontend/backend deployments.
+ * When `backendUrl` is configured, this middleware adds the necessary CORS
+ * headers so the browser allows cross-origin API requests from the static
+ * frontend to the backend server.
+ */
+export function cors() {
+    return async (c, next) => {
+        const config = Config.getGlobal();
+        const origin = config?.backendUrl;
+        if (origin) {
+            c.header('Access-Control-Allow-Origin', origin);
+            c.header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+            c.header('Access-Control-Allow-Headers', 'Content-Type');
+            if (c.req.method === 'OPTIONS') {
+                return c.body(null, 204);
+            }
+        }
+        await next();
+    };
+}
+export default cors;
+//# sourceMappingURL=cors.js.map
