    "@refinedev/core" : "4.54.0"
  },
  "devDependencies": {
    "@types/react": "18.2.75",
    "@types/react-dom": "18.2.14",
    "typescript": "~5.6.3",
    "@types/node": "22.2.0",
    "eslint": "~8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^7.3.0",
    "eslint-plugin-react": "7.34.2",
    "eslint-plugin-react-hooks": "4.6.0",
