{
  "name": "@lumeweb/web",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "publish": "changeset publish",
    "changeset:publish": "pnpm -r publish --publish-branch develop; pnpm changeset tag && git push --follow-tags",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:docs.lumeweb.com": "turbo build --filter=@lumeweb/docs.lumeweb.com",
    "build:lumeweb.com": "turbo build --filter=@lumeweb/lumeweb.com",
    "build:portal-dashboard": "turbo build --filter=@lumeweb/portal-dashboard",
    "build:portal-admin": "turbo build --filter=@lumeweb/portal-admin",
    "build:portal-frontend": "turbo build --filter=@lumeweb/portal-frontend",
    "dev:portal-dashboard": "turbo dev --filter=@lumeweb/portal-dashboard"
  },
  "private": true,
  "dependencies": {
    "@refinedev/core": "4.57.9",
    "autoprefixer": "^10.4.18",
    "postcss": "8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.6",
    "@eslint/js": "^9.20.0",
    "@module-federation/vite": "^1.4.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/addon-themes": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.1.3",
    "@vitest/spy": "^3.1.3",
    "eslint": "~8.57.1",
    "eslint-plugin-perfectionist": "^4.8.0",
    "eslint-plugin-react": "7.34.2",
    "eslint-plugin-react-hooks": "~4.6.0",
    "globals": "^15.14.0",
    "happy-dom": "^17.4.7",
    "nock": "^14.0.4",
    "orval": "^7.9.0",
    "playwright": "^1.52.0",
    "prettier": "^3.3.3",
    "storybook": "^8.0.0",
    "tsdown": "^0.12.7",
    "tsup": "^8.4.0",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.3.4",
    "vitest": "^3.1.3",
    "vitest-browser-react": "^0.1.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "object-inspect": "patches/object-inspect.patch",
      "@refinedev/core": "patches/@refinedev__core.patch",
      "@module-federation/vite": "patches/@module-federation__vite.patch",
      "@vitejs/plugin-react": "patches/@vitejs__plugin-react.patch",
      "react-hook-form": "patches/react-hook-form.patch",
      "@module-federation/bridge-react": "patches/@module-federation__bridge-react.patch",
      "@refinedev/react-hook-form": "patches/@refinedev__react-hook-form.patch"
    },
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.3",
      "@types/react-dom": "18.3.0",
      "react-router-dom": "7.5.0",
      "@tanstack/react-query": "4.36.1",
      "@tanstack/react-query-devtools": "4.36.1",
      "react-hook-form": "7.54.0",
      "zod": "3.24.2",
      "vite": "6.1.6",
      "tsdown": "^0.12.7"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
