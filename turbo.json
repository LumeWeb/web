{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "docs/dist/**"]
    },
    "build:dashboard": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/dashboard/**"]
    },
    "build:admin": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/admin/**"]
    },
    "build:lib": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["lib-dist/**"]
    },

    "build-dev": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "storybook": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"]
    }
  }
}
