---
import NewsletterSignup from "@/components/NewsletterSignup";
import PaymentMethodsBar from "@/components/PaymentMethodsBar";
import { getCollection } from "astro:content";
import { footerProductLinks, footerCommunityLinks, footerLegalLinks } from "@/data/navLinks";
import contactsData from "@/data/contacts.json";

interface Props {
  theme?: "dark" | "light";
  lastUpdated?: string;
  showNewsletter?: boolean;
}

const { theme = "dark", lastUpdated, showNewsletter = true } = Astro.props;

const alternatives = await getCollection('alternatives');
const featuredAlts = alternatives
  .filter(a => a.data.featured)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const isDark = theme === "dark";

const t = {
  bg: isDark ? "bg-home-section-dark" : "bg-home-text",
  columnTitle: isDark ? "text-home-text" : "text-content-text",
  link: isDark ? "text-gray-footer hover:text-white" : "text-content-text-muted hover:text-content-text",
  copyright: isDark ? "text-content-text-light" : "text-content-text",
  small: isDark ? "text-gray-footer" : "text-content-text-muted",
  smallLink: isDark ? "text-gray-footer hover:text-white" : "text-content-text-muted hover:text-content-text",
};

const columns = [
  {
    title: "Product",
    links: footerProductLinks.map(l => ({ text: l.label, url: l.href, external: l.external })),
  },
  {
    title: "Compare",
    links: [
      ...featuredAlts.map(a => ({ text: `${a.data.name} Alternative`, url: `/alternatives/${a.data.slug}` })),
      { text: "View all comparisons →", url: "/alternatives" },
    ],
  },
  {
    title: "Community",
    links: footerCommunityLinks.map(l => ({ text: l.label, url: l.href, external: l.external })),
  },
  {
    title: "Legal",
    links: footerLegalLinks.map(l => ({ text: l.label, url: l.href, external: l.external })),
  },
];
---

<footer class={t.bg}>
  <div class="container py-8">
    <div class="flex flex-col items-center gap-6">
      {showNewsletter && <NewsletterSignup theme={theme} />}

      <PaymentMethodsBar variant="dark" compact />

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 w-full">
        {columns.map((col) => (
          <div>
            <p class={`${t.columnTitle} mb-4 text-[13px] md:text-lg font-medium`}>{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class={`${t.link} text-[12px] underline md:no-underline md:text-base leading-[31px] md:leading-[34px] transition ease-in-out duration-300`}
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="text-center">
        <p class={`${t.copyright} text-base md:text-lg font-medium tracking-wide mb-1`}>
          Your data. Your rules.
        </p>
        <p class={`${t.copyright} text-sm`}>
          A{" "}
          <a
            href="https://lumeweb.com"
            target="_blank"
            rel="noopener noreferrer"
            class={`${t.smallLink} transition-colors duration-300`}
          >
            Lume Web
          </a>{" "}
          service
        </p>
        <p class={`${t.copyright} text-base mt-1`}>
          © 2024 – {(new Date()).getFullYear()} Hammer Technologies LLC
        </p>
        <p class={`${t.small} text-sm mt-2`}>
          Site last updated: {lastUpdated ?? `${new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date())}`}
        </p>
        <p class={`${t.small} text-xs mt-2 opacity-50`}>
          This site is hosted on Pinner. IPNS: <code class="font-mono">k51qzi5uqu5dm5cxud9ascpp15dgw43xcbbo20kixob7u5e83z1kudtlrgiwxe</code>
        </p>
        <p class={`${t.small} text-sm mt-1`}>
          <a href="/privacy-policy" class={`${t.smallLink} transition ease-in-out duration-300`}>Privacy</a>
          <span class="mx-1">·</span>
          <a href="/terms-of-service" class={`${t.smallLink} transition ease-in-out duration-300`}>Terms</a>
        </p>
      </div>
    </div>
  </div>
</footer>
