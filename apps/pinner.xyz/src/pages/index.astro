---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Home/Hero";
import BrandLogos from "@/components/BrandLogos";
import WhyPinner from "@/components/Home/WhyPinner";
import BottomCTA from "@/components/Home/BottomCTA";
import logos from "@/data/brand-logos";
---

<Layout
  title="Storage and Hosting Where You're in Control | Pinner"
  description="Your data. Your rules. Decentralized hosting and storage that doesn't depend on one company."
  variant="home"
>
  <Hero client:load />
  <BrandLogos
    logos={logos}
    logoType="dark"
    title="Built On"
    variant="dark"
    client:load
  />
  <WhyPinner client:load />
  <!-- SocialProof: render only if real data exists -->
  <!-- <SocialProof client:load /> -->
  <BottomCTA client:load />
</Layout>
