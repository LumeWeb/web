---
import Layout from "@/layouts/Layout.astro";
import EnsHero from "@/components/Home/EnsHero";
import TerminalStep from "@/components/Home/TerminalStep";
import UploadFlowDiagramDark from "@/components/HowItWorks/UploadFlowDiagramDark";
import DistributionDiagramDark from "@/components/HowItWorks/DistributionDiagramDark";
import { TrackedButton } from "@/components/TrackedButton";
import { config, examples } from "@/lib/config";
---

<Layout
  title="Host Your .eth Website on Independent Providers | Pinner"
  description="Point your ENS name at content hosted on the Sia network. Two commands: upload and point. The CLI gives you the exact contenthash."
  variant="home"
  ogImage="/images/og/ens.png"
  showNewsletterFooter={false}
>
  {/* Section 1: Hero */}
  <EnsHero client:load />

  {/* Section 2: Agitation: Three ways ENS hosting goes wrong */}
  <section class="py-20 md:py-28 bg-home-section-dark">
    <div class="xl:container px-6">
      <div class="max-w-[800px] mx-auto">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          Three ways ENS hosting goes wrong
        </h2>

        <div class="space-y-8">
          {/* Fleek */}
          <div class="flex gap-5 items-start">
            <div class="w-10 h-10 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </div>
            <div>
              <h3 class="text-white text-lg font-medium mb-2">Fleek shut down</h3>
              <p class="text-home-text-muted text-base leading-relaxed">
                January 2026. Fleek discontinued IPFS hosting. Any .eth site pointing at Fleek went offline. Users scrambled to find a new host and update their contenthash.
              </p>
            </div>
          </div>

          {/* Pinata */}
          <div class="flex gap-5 items-start">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <div>
              <h3 class="text-white text-lg font-medium mb-2">Pinata's pricing wall</h3>
              <p class="text-home-text-muted text-base leading-relaxed">
                Pinata is the biggest IPFS host. Their free tier covers almost nothing. The jump to paid is 20 USD/month minimum. For a static site. That's 240 USD/year for a hobby project.
              </p>
            </div>
          </div>

          {/* Self-hosting */}
          <div class="flex gap-5 items-start">
            <div class="w-10 h-10 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h3 class="text-white text-lg font-medium mb-2">Self-hosting is a job</h3>
              <p class="text-home-text-muted text-base leading-relaxed">
                Run Kubo 24/7, manage peering, and monitor disk space. Your .eth site depends on your server staying online. One reboot and your site is unreachable.
              </p>
            </div>
          </div>
        </div>

        <p class="text-home-text-muted text-base text-center mt-10">
          Your ENS name is permanent. Your hosting shouldn't be the weak link.
        </p>
      </div>
    </div>
  </section>

  {/* Section 3: How It Works */}
  <section id="how-it-works" class="py-20 md:py-28">
    <div class="xl:container px-6">
      <div class="lg:flex lg:items-center lg:justify-between gap-16">
        <div class="lg:w-1/2">
          <p class="text-home-accent text-sm font-semibold uppercase tracking-wider mb-4">
            How it works
          </p>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-6">
            Two commands to a live .eth site
          </h2>
          <p class="text-home-text-muted text-base md:text-lg leading-relaxed mb-8">
            Build your site anywhere. Upload with one command. Point your name with another. The CLI gives you the contenthash. Paste it into app.ens.domains. Done.
          </p>

          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-8 h-8 rounded-full bg-home-accent/10 border border-home-accent/20 flex items-center justify-center shrink-0 text-home-accent font-semibold text-sm">
                1
              </div>
              <div class="flex-1">
                <h3 class="text-white font-medium mb-2">Build</h3>
                <p class="text-home-text-muted text-sm leading-relaxed mb-3">
                  Any static framework. Astro, Hugo, Next.js static export, or plain HTML.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 rounded-full bg-home-accent/10 border border-home-accent/20 flex items-center justify-center shrink-0 text-home-accent font-semibold text-sm">
                2
              </div>
              <div class="flex-1">
                <h3 class="text-white font-medium mb-2">Upload</h3>
                <p class="text-home-text-muted text-sm leading-relaxed mb-3">
                  Your files are on IPFS.
                </p>
                <TerminalStep
                  command="pinner upload ./dist"
                  output={[`CID ${examples.cid}`, "Size 2.4 MB", "Status Pinned"]}
                  client:load
                />
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 rounded-full bg-home-accent/10 border border-home-accent/20 flex items-center justify-center shrink-0 text-home-accent font-semibold text-sm">
                3
              </div>
              <div class="flex-1">
                <h3 class="text-white font-medium mb-2">Point</h3>
                <p class="text-home-text-muted text-sm leading-relaxed mb-3">
                  Copy the contenthash. Paste into app.ens.domains. Save.
                </p>
                <TerminalStep
                  command="pinner point myname.eth --cid <cid>"
                  output={[`Contenthash: ${examples.cid}`]}
                  client:load
                />
              </div>
            </div>
          </div>
        </div>

        <div class="lg:w-1/2 mt-12 lg:mt-0">
          <UploadFlowDiagramDark client:load />
        </div>
      </div>
    </div>
  </section>

  {/* Section 4: What You Get / What You Don't */}
  <section class="py-20 md:py-28 bg-home-section-dark">
    <div class="xl:container px-6">
      <div class="max-w-[1000px] mx-auto">
        {/* What you get */}
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          What you get
        </h2>
        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-home-accent/10 border border-home-accent/20 text-home-accent mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Contenthash in CLI output</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Run <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code> and the terminal shows your exact ENS contenthash. No manual CID conversion. Copy, paste, done.
            </p>
          </div>

          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-home-accent/10 border border-home-accent/20 text-home-accent mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">IPNS for updates</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code> creates an IPNS name. Update your site by re-running the command with a new CID. Your ENS contenthash stays the same.
            </p>
          </div>

          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-home-accent/10 border border-home-accent/20 text-home-accent mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Content on independent hosts</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Files copied across the Sia network. No single provider can delete them all. Harder for one provider to take down.
            </p>
          </div>
        </div>

        {/* What you don't */}
        <h3 class="text-xl md:text-2xl font-semibold text-white/60 mb-8 text-center">
          What you don't
        </h3>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <h4 class="text-white/60 font-medium mb-2">No ENS registration</h4>
            <p class="text-home-text-muted/60 text-sm leading-relaxed">
              We don't sell .eth names. You bring your own ENS name from ENS domains.
            </p>
          </div>
          <div class="text-center">
            <h4 class="text-white/60 font-medium mb-2">No dynamic content</h4>
            <p class="text-home-text-muted/60 text-sm leading-relaxed">
              Static files only. No server-side code, no databases, no APIs.
            </p>
          </div>
          <div class="text-center">
            <h4 class="text-white/60 font-medium mb-2">No guaranteed resolution speed</h4>
            <p class="text-home-text-muted/60 text-sm leading-relaxed">
              eth.limo and IPFS gateways vary in speed. Your site stays available, but initial load can be slower than traditional hosting.
            </p>
          </div>
        </div>

        <p class="text-home-text-muted text-base text-center mt-10 max-w-lg mx-auto">
          If you need dynamic content or edge functions, use Vercel alongside Pinner for static assets with your ENS name.
        </p>
      </div>
    </div>
  </section>

  {/* Section 5: Your Site, Distributed */}
  <section class="py-20 md:py-28">
    <div class="xl:container px-6">
      <div class="lg:flex lg:items-center lg:justify-between gap-16">
        <div class="lg:w-1/2 order-2 lg:order-1">
          <DistributionDiagramDark client:load />
        </div>
        <div class="lg:w-1/2 order-1 lg:order-2">
          <p class="text-home-accent text-sm font-semibold uppercase tracking-wider mb-4">
            How it stays online
          </p>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-6">
            A network behind your name
          </h2>
          <p class="text-home-text-muted text-base md:text-lg leading-relaxed">
            Your files split into encrypted pieces and stored across independent providers on the Sia network. If one goes offline, others keep serving your site as long as your account is active. You set the contenthash once in ENS. Pinner keeps it pinned.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Section 6: Works with Your Frameworks */}
  <section class="py-20 md:py-28 bg-home-section-dark">
    <div class="xl:container px-6">
      <div class="max-w-[800px] mx-auto text-center">
        <p class="text-home-accent text-sm font-semibold uppercase tracking-wider mb-4">
          Build with anything
        </p>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-6">
          If it builds to static files, it works
        </h2>
        <p class="text-home-text-muted text-base md:text-lg leading-relaxed">
          Astro, Next.js, Hugo, Gatsby, Jekyll, Eleventy, VitePress, Docusaurus: build anywhere, deploy with one command, point your ENS name at the result.
        </p>
      </div>
    </div>
  </section>

  {/* Section 7: What You Can Host on ENS */}
  <section class="py-20 md:py-28">
    <div class="xl:container px-6">
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          What you can host on ENS
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Personal Sites</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Portfolio, blog, or homepage on your .eth name. Update anytime by re-running <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code> with a new CID.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">dApp Frontends</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Host your decentralized app interface. Users visit yourname.eth.limo and get the latest version.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Project Landing Pages</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Crypto project? DAO? Open source tool? Point your .eth name at a professional landing page that stays up.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Documentation</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Docs for your protocol or library. Content-addressed so links don't break. IPNS for updates without touching ENS.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 8: Honest Comparison */}
  <section class="py-20 md:py-28 bg-home-section-dark">
    <div class="xl:container px-6">
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          How ENS hosting compares
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-home-text/10">
                <th class="text-left text-home-text-muted font-medium py-3 pr-4"></th>
                <th class="text-left text-white font-semibold py-3 px-4">Pinner + ENS</th>
                <th class="text-left text-home-text-muted font-medium py-3 px-4">Fleek</th>
                <th class="text-left text-home-text-muted font-medium py-3 px-4">Pinata</th>
                <th class="text-left text-home-text-muted font-medium py-3 px-4">Self-hosted Kubo</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">Still operating</td>
                <td class="text-home-accent py-3 px-4">Yes</td>
                <td class="text-home-text-muted py-3 px-4">No (shut down Jan 2026)</td>
                <td class="text-home-text-muted py-3 px-4">Yes</td>
                <td class="text-home-text-muted py-3 px-4">Yes</td>
              </tr>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">CLI contenthash</td>
                <td class="text-home-accent py-3 px-4">Yes</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
              </tr>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">IPNS for updates</td>
                <td class="text-home-accent py-3 px-4">Yes</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">Limited</td>
                <td class="text-home-text-muted py-3 px-4">Manual</td>
              </tr>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">Distributed backend</td>
                <td class="text-home-accent py-3 px-4">Yes</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">Yes</td>
              </tr>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">Minimum cost</td>
                <td class="text-home-accent py-3 px-4">50 USD/year</td>
                <td class="text-home-text-muted py-3 px-4">N/A</td>
                <td class="text-home-text-muted py-3 px-4">Free tier</td>
                <td class="text-home-text-muted py-3 px-4">Ops cost</td>
              </tr>
              <tr class="border-b border-home-text/10">
                <td class="text-white font-medium py-3 pr-4">Run a node yourself</td>
                <td class="text-home-accent py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">No</td>
                <td class="text-home-text-muted py-3 px-4">Yes</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-home-text-muted text-sm mt-6 max-w-[800px]">
          Fleek shut down their IPFS hosting in January 2026. Pinata offers IPFS pinning with a free tier and supports ENS via manually pasted CIDs, but does not provide an ENS contenthash CLI command or managed IPNS republishing. Self-hosting with Kubo gives full control but requires 24/7 server management and manual IPNS publishing.
        </p>
      </div>
    </div>
  </section>

  {/* Section 9: Simple Pricing */}
  <section class="py-20 md:py-28">
    <div class="xl:container px-6">
      <div class="max-w-[600px] mx-auto text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-4">
          One price. No minimums.
        </h2>
        <p class="text-home-text-muted text-base md:text-lg mb-10">
          Fixed yearly pricing. Bandwidth included. No API call charges, no surprise egress bills. Cancel anytime.
        </p>
        <TrackedButton
          label="See full pricing"
          url="/pricing"
          buttonStyle="btn-light"
          trackEvent="ens_pricing_cta_clicked"
          client:load
        />
      </div>
    </div>
  </section>

  {/* Section 10: Risk Reversal */}
  <section class="py-20 md:py-28 bg-home-section-dark">
    <div class="xl:container px-6">
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          Risk-free to try
        </h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Cancel anytime</h3>
            <p class="text-sm text-home-text-muted leading-relaxed max-w-xs mx-auto">
              No annual contracts. Leave when you want.
            </p>
          </div>

          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">We'll make it right</h3>
            <p class="text-sm text-home-text-muted leading-relaxed max-w-xs mx-auto">
              Something not working? Contact us and we'll fix it.
            </p>
          </div>

          <div class="text-center">
            <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">10-minute promise</h3>
            <p class="text-sm text-home-text-muted leading-relaxed max-w-xs mx-auto">
              Install the CLI. Run two commands. Your contenthash is ready within 10 minutes. DNS propagation (eth.limo) varies but is typically fast.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 11: FAQ */}
  <section class="py-20 md:py-28">
    <div class="xl:container px-6">
      <div class="max-w-[800px] mx-auto">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-12 md:mb-16 text-center">
          Frequently asked questions
        </h2>

        <div class="space-y-4">
          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Do I need to already own an ENS name?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Yes. We don't sell .eth names. Register at app.ens.domains, then come back and host your site.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">How do I set my ENS contenthash?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              After running <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code>, your terminal shows the contenthash. Copy it, go to app.ens.domains, find your name, paste the contenthash in the 'Content' field, and save. It usually takes a few minutes to propagate.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">What is IPNS and why do I want it?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              IPNS is a mutable pointer. <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code> creates an IPNS name for your content. When you update your site, run <code class="bg-home-text/10 px-1.5 py-0.5 rounded text-home-text">pinner point</code> again with a new CID. Your ENS contenthash stays the same. Your site updates automatically.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Can I use a different resolver than eth.limo?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Yes. Your contenthash works with any ENS resolver that supports IPNS. eth.limo is the most common, but others work too.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Is my site always online?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              We copy your files across the Sia network to independent hosts. If one host goes offline, others keep serving your content as long as your account is active and Pinner is operational.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">What if Pinner shuts down?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Your contenthash points to an IPFS address. If you pin the same CID elsewhere, your ENS name still works. We recommend keeping a backup pin for critical sites.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">Can I host a Next.js app with SSR?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              No. Static export only. If you need SSR, use Vercel for the dynamic parts and point your ENS name at a static landing page hosted on Pinner.
            </p>
          </div>

          <div class="bg-home-card-bg rounded-lg p-6 border border-home-text/10">
            <h3 class="text-white font-medium mb-2">How does pricing work?</h3>
            <p class="text-home-text-muted text-sm leading-relaxed">
              Simple yearly subscription. Bandwidth included. No per-request fees. Cancel anytime.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 12: Bottom CTA */}
  <section class="py-20 md:py-32 bg-home-section-dark">
    <div class="xl:container px-6 text-center">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-4 lg:mb-6">
        Your .eth name is waiting for content.
      </h2>
      <p class="text-home-text-muted text-base md:text-lg mb-10 max-w-md mx-auto">
        Two commands to a live .eth site. Cancel anytime.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <TrackedButton
          label="Start hosting"
          url={config.registerUrl("hosting")}
          buttonStyle="btn-light"
          trackEvent="ens_bottom_cta_start_clicked"
          client:load
        />
        <TrackedButton
          label="See how it works"
          url="#how-it-works"
          buttonStyle="outline"
          trackEvent="ens_bottom_cta_how_clicked"
          client:load
        />
      </div>
    </div>
  </section>

</Layout>
