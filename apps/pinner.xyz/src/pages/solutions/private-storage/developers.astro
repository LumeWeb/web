---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import AboutSection from '@/components/AboutSection';
import CallToAction from '@/components/CallToAction';
import FAQ from '@/components/FAQ';
import BrandLogos from '@/components/BrandLogos';
import RelatedPages from '@/components/RelatedPages.astro';
import logos from '@/data/brand-logos';

import HowItWorksImage from "@/assets/how-it-works-1.png";
import HowItWorksMobile from "@/assets/how-it-works-mobile-1.png";
import StorageImage from "@/assets/how-it-works-2.png";
import StorageMobile from "@/assets/how-it-works-mobile-2.png";

const faqs = [
  {
    question: "What can I build on this?",
    answer: "Anything that stores data privately. Backup tools, file sync apps, database storage, encrypted note-taking. If your app needs to store data that only the user can read, this layer handles it."
  },
  {
    question: "How does the revenue share work?",
    answer: "When users sign up through your app and store data on Pinner, you earn a share of their storage revenue. <a href='/partners' class='underline hover:text-content-text transition-colors'>See the partner program</a> for full details, eligibility, and terms."
  },
  {
    question: "What's different from using S3 directly?",
    answer: "S3 is one interface to the storage layer. If your app needs object storage, use S3. If you need lower-level access or a different interface, the same encrypted storage layer is available through the Sia SDK."
  }
];
---

<Layout title="Build Apps on Encrypted Storage | Developer Platform" description="Build applications on encrypted, peer-to-peer storage. S3-compatible API, revenue sharing for app developers, and the Sia SDK for direct access.">
  <PageHeader
    title="Build Apps on Encrypted Storage"
    mobileTitle="Developer Platform"
    description="Build applications on encrypted, peer-to-peer storage. S3-compatible API for object storage, revenue sharing when your users store data, and the Sia SDK for direct access."
    btnText="View Partner Program →"
    url="/partners"
    client:load
  />

  <AboutSection
    subtitle="Storage Layer"
    title="One Storage Layer, Many Applications"
    description="S3-compatible storage is just the first interface built on this layer. The same encrypted, peer-to-peer storage can power databases, file sync, backup tools, or anything else you want to build. Your app, our infrastructure."
    theme="white"
    imageUrl={HowItWorksImage}
    imgageMobileUrl={HowItWorksMobile}
    client:load
  />

  <AboutSection
    subtitle="Architecture"
    title="How It Works"
    theme="gray"
    imagePosition="right"
    imageUrl={StorageImage}
    imgageMobileUrl={StorageMobile}
    client:load
  >
    <p>Technical overview. Your app sends data through the storage layer. Data is encrypted client-side. Fragments are distributed across the Sia network. Only your user holds the key.</p>
    <p>The live interface today is S3-compatible. Here's a simple example:</p>
    <pre><code>aws s3 cp backup.tar.gz s3://my-bucket/ --endpoint-url https://your-server.example</code></pre>
    <p>Or with curl:</p>
    <pre><code>curl -X PUT https://your-server.example/my-bucket/backup.tar.gz \
  -H "Authorization: Bearer $TOKEN" \
  -T backup.tar.gz</code></pre>
    <p>The Sia SDK is also available for direct access to the storage layer if you need lower-level control.</p>
  </AboutSection>

  <AboutSection
    subtitle="Revenue Sharing"
    title="Earn When Your Users Store Data"
    description="When your app's users sign up for Pinner and store data, you earn a share. This is a program with eligibility and terms. Not a guarantee. <a href='/partners' class='underline hover:text-content-text transition-colors'>See the partner program</a> for full details."
    theme="white"
    imageUrl={HowItWorksImage}
    client:load
  />

  <section class="py-[60px] md:py-[120px] bg-white">
    <div class="xl:container px-6">
      <h2 class="text-[24px] sm:text-[28px] md:text-[31px] font-medium text-content-text text-center mb-10 md:mb-14">Frequently Asked Questions</h2>
      <FAQ faqs={faqs} client:load />
    </div>
  </section>

  <RelatedPages links={[
    { href: "/solutions/s3-storage", label: "S3 Storage", description: "S3-compatible object storage on a peer-to-peer network" },
    { href: "/partners", label: "Partner Program", description: "Revenue sharing, integration support, and custom pricing" },
  ]} />

  <section class="py-8 bg-white">
    <div class="xl:container px-6 text-center">
      <p class="text-content-text-muted text-sm">
        Just need private storage? <a href="/solutions/private-storage/personal" class="underline hover:text-content-text transition-colors">See personal storage →</a>
      </p>
    </div>
  </section>

  <BrandLogos logos={logos} logoType="light" title="Built On" variant="white" client:load />

  <CallToAction client:load />
</Layout>
