---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import AboutSection from '@/components/AboutSection';
import CallToAction from '@/components/CallToAction';
import FAQ from '@/components/FAQ';
import BrandLogos from '@/components/BrandLogos';
import RelatedPages from '@/components/RelatedPages.astro';
import PlanTable from '@/components/PlanTable.astro';
import logos from '@/data/brand-logos';

import AboutWhatIsPinner from "@/assets/about-what-is-pinner.jpg";
import AboutHowItWorks from "@/assets/about-how-it-works.jpg";
import AboutValues from "@/assets/about-values.jpg";

const planRows = [
  { factor: "What you pay for", detail: "Storage and bandwidth only" },
  { factor: "Storage layer", detail: "Sia network: hosts prove they're storing your data to get paid" },
  { factor: "Content addressing", detail: "Every file gets a permanent, verifiable hash" },
  { factor: "Crypto payments", detail: "Available, no identity verification required" },
  { factor: "Static site hosting", detail: "HTML, CSS, JS. Deploy and go" },
  { factor: "Domain support", detail: "Custom domains with SSL, IPNS addresses" },
  { factor: "IPFS pinning", detail: "Standard CIDs and content addressing" },
  { factor: "Data durability", detail: "Your data lives on independent hosts, not one company's servers" },
];

const faqs = [
  {
    question: "I'm migrating from Fleek. What do I need?",
    answer: "Your site files (HTML, CSS, JS) and your custom domain if you had one. Content addresses (CIDs) are determined by your file's content, so the same files produce the same CIDs. Deploy your files to Pinner, point your domain, and you're live."
  },
  {
    question: "What happened to Fleek?",
    answer: "Fleek's IPFS hosting shut down in January 2026. The company pivoted to AI inference, and their hosting and storage services are no longer available."
  },
  {
    question: "How is Pinner different from Fleek?",
    answer: "At the distribution level, not much. We serve your site over HTTP and peer-to-peer, and if we stop operating, your site goes offline. The difference is storage: Fleek's data lived on their own infrastructure and disappeared when they shut down. Pinner stores data on the Sia network, where independent hosts are paid to store it and must prove they're doing it to get paid. The data doesn't live on our servers."
  },
  {
    question: "Can I use the same content addresses?",
    answer: "If you have the original files, yes. Content addresses (CIDs) are determined by your file's content, not by the provider. The same file has the same CID on any IPFS service."
  },
  {
    question: "What kinds of sites work on Pinner?",
    answer: "Static sites: HTML, CSS, and JavaScript. Portfolios, documentation, landing pages, blogs generated by static site generators (Hugo, Astro, Jekyll, Next.js static export). No server-side rendering or dynamic backends."
  }
];
---

<Layout title="Fleek Alternative for Static Site Hosting | Pinner" description="Fleek's IPFS hosting shut down in January 2026. Deploy your static site on Pinner. Data stored on the Sia network by independent hosts who are paid to store it.">
  <PageHeader
    title="A host that's built to stick around"
    mobileTitle="Fleek Alternative"
    description="Fleek's IPFS hosting shut down in January 2026 and took hosted sites with it. Fleek refugees welcome. Your data on Pinner lives on the Sia network, stored by independent hosts who are paid to keep it, not on our servers."
    btnText="Start Hosting →"
    url="https://account.pinner.xyz"
    secondaryBtnText="See Pricing →"
    secondaryUrl="/pricing"
    client:load
  />

  <AboutSection
    subtitle="Why hosts disappear"
    title="When your host's incentives don't align with yours"
    description="When a venture-backed company pivots, the product you depend on can disappear overnight. Fleek raised millions in venture funding, then pivoted from IPFS hosting to AI agents. Their hosting customers lost their sites. That's not a knock on Fleek; it's how venture-funded businesses work. They chase the next growth curve. Pinner is a small business built around our users. We charge for storage and bandwidth, we keep costs low, and we don't have investors pushing us to pivot. Different model, different risk."
    theme="white"
    imageUrl={AboutWhatIsPinner}
    client:load
  />

  <AboutSection
    subtitle="Storage"
    title="Your data lives on a network, not our servers"
    description="Your data is stored on the Sia network, distributed across independent hosts who are paid to store it and must prove they're doing it. If a host drops off, the network re-replicates to another. Hosts lose money if they lose your data, so they don't. On the serving side, we distribute your site over HTTP and peer-to-peer (IPFS). If our gateway goes down, your site goes down, but your data stays on the network because it doesn't live on our servers."
    theme="gray"
    imagePosition="right"
    imageUrl={AboutHowItWorks}
    client:load
  />

  <AboutSection
    subtitle="Getting Started"
    title="Deploy your static site"
    description="If you have your site files (HTML, CSS, JS), deploy them to Pinner and get a live URL. Static sites, portfolios, documentation sites, and dApps all work. No server-side rendering or dynamic backends."
    theme="white"
    imageUrl={AboutValues}
    client:load
  />

  <section class="py-[60px] md:py-[120px] bg-white">
    <div class="xl:container px-6">
      <h2 class="text-[24px] sm:text-[28px] md:text-[31px] font-medium text-content-text text-center mb-10 md:mb-14">Frequently Asked Questions</h2>
      <FAQ faqs={faqs} client:load />
    </div>
  </section>

  <PlanTable rows={planRows} client:load />

  <RelatedPages links={[
    { href: "/solutions/website-hosting", label: "Website Hosting", description: "Host static sites on a peer-to-peer network" },
    { href: "/solutions/ipfs-pinning", label: "IPFS Pinning", description: "Pin files with permanent, verifiable addresses" },
  ]} />

  <BrandLogos logos={logos} logoType="light" title="Built On" variant="white" client:load />

  <CallToAction client:load />
</Layout>
