---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import { getCollection } from 'astro:content';

const alternatives = await getCollection('alternatives');
const altPriority = ['Filebase', 'Fleek', 'Infura', 'Pinata'];
const sorted = alternatives.sort((a, b) => {
  const ai = altPriority.indexOf(a.data.name);
  const bi = altPriority.indexOf(b.data.name);
  const aRank = (ai === -1 ? 99 : ai);
  const bRank = (bi === -1 ? 99 : bi);
  if (aRank !== bRank) return aRank - bRank;
  return a.data.name.localeCompare(b.data.name);
});
---

<Layout title="Compare Pinner Against Other Platforms" navTheme="dark" description="A simple index of our comparison pages. If you are weighing Pinner against another hosting, storage, or pinning platform, you can start here.">
  <PageHeader
    title="Compare Pinner against other platforms"
    description="A simple index of our comparison pages. If you are weighing Pinner against another hosting, storage, or pinning platform, you can start here."
    client:load
  />

  <section class="bg-[#F8F8F8] py-[60px] md:py-[100px]">
    <div class="container">
      <div class="mx-auto max-w-[960px] grid gap-6 md:grid-cols-2">
        {sorted.map((alt) => (
          <a
            href={`/alternatives/${alt.data.slug}`}
            class="group block rounded-xl border border-[#E4E0D4] bg-white p-6 md:p-8 hover:border-[#0D1D1C] transition-colors duration-200"
          >
            <p class="text-content-text text-lg md:text-xl font-medium mb-2 group-hover:underline">
              Pinner vs {alt.data.name}
            </p>
            <p class="text-content-text-muted text-sm md:text-base leading-relaxed">
              {alt.data.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
