---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import AboutSection from '@/components/AboutSection';
import CallToAction from '@/components/CallToAction';
import FAQ from '@/components/FAQ';
import BrandLogos from '@/components/BrandLogos';
import RelatedPages from '@/components/RelatedPages.astro';
import PlanTable from '@/components/PlanTable.astro';
import logos from '@/data/brand-logos';
import { config, ctaCopy } from '@/lib/config';
import { frameworkList } from '@/lib/frameworks';

import ValuesSection from "@/components/HowItWorks/ValuesSection";
import UploadFlowSection from "@/components/HowItWorks/UploadFlowSection";
import DistributionSection from "@/components/HowItWorks/DistributionSection";

const planRows = [
  { factor: "What you pay for", detail: "5 USD/mo for 250 GB bandwidth" },
  { factor: "Storage layer", detail: "Sia network: independent hosts prove they're storing your data to get paid" },
  { factor: "Content addressing", detail: "Every file gets a permanent, verifiable hash so your data is portable" },
  { factor: "Payment methods", detail: "Crypto or card. No KYC for crypto." },
  { factor: "File limits", detail: "No file count caps, no file size caps" },
  { factor: "Domain support", detail: "Custom domains with SSL. Works with any DNS provider." },
  { factor: "Vendor lock-in", detail: "Content-addressed storage means your data is verifiable and portable" },
  { factor: "Product focus", detail: "Built for static hosting" },
];

const faqs = [
  {
    question: "What does Pinner cost?",
    answer: "5 USD/mo for 250 GB bandwidth. No per-seat pricing, no build-minute billing, no usage metering."
  },
  {
    question: "Can I pay with crypto?",
    answer: "Yes. Crypto or card. No KYC required for crypto payments. Pinner is also fully open source so you can inspect the code, run your own instance, or verify how your data is handled."
  },
  {
    question: "Can I use my own DNS provider?",
    answer: "Yes. Point an A or CNAME record at Pinner and you're done. No nameserver requirements."
  },
  {
    question: "How is Pinner different from Cloudflare Pages?",
    answer: "Pinner is built specifically for static hosting. Your data lives on the Sia network on independent hosts who are paid to store it. Crypto payments with no KYC, no file count caps, no file size caps, and no DNS provider lock-in."
  },
  {
    question: "What kinds of sites work on Pinner?",
    answer: `Static sites: HTML, CSS, and JavaScript. Portfolios, documentation, landing pages, blogs generated by static site generators (${frameworkList({ format: "technical" })}). No server-side rendering or dynamic backends.`
  }
];
---

<Layout title="Cloudflare Pages Alternative for Static Site Hosting | Pinner" description="Static site hosting on the Sia network with crypto payments, no KYC, no file caps, and open-source code. 5 USD/mo, works with any DNS provider.">
  <PageHeader
    title="Static hosting with no file caps and no DNS lock-in"
    description="5 USD/mo for 250 GB bandwidth. Crypto or card, no KYC for crypto. No file count limits, no file size limits, works with any DNS provider."
    btnText="Start Hosting →"
    url={config.registerUrl("hosting")}
    secondaryBtnText="See Pricing →"
    secondaryUrl="/pricing"
    client:load
  />

  <UploadFlowSection
    subtitle="Why Pinner"
    title="Static site hosting built to last"
    description="Your data lives on the Sia network across independent hosts who are paid to store it and must prove they're doing it. Pinner is built for static hosting and that's the product. Content addressing means your data is verifiable and portable."
    theme="white"
    client:load
  />

  <DistributionSection
    subtitle="Storage"
    title="Your data lives on a network, not one company's servers"
    description="Pinner stores your data on the Sia network, distributed across independent hosts who are paid to store it and must prove they're doing it. Content addressing means your data is verifiable and portable with no vendor lock-in on storage. On the serving side, we distribute your site over HTTP and peer-to-peer (IPFS)."
    theme="gray"
    imagePosition="right"
    client:load
  />

<ValuesSection
  subtitle="What Pinner does and doesn't"
  title="Straightforward hosting with clear pricing"
  description="No file count caps. No file size limits. Use any DNS provider. 5 USD/mo for 250 GB bandwidth. Crypto payments with no KYC. Pinner is open source. Your data on the Sia network lives across independent hosts, so no single entity can take it down."
  theme="white"
  client:load
/>

  <section class="py-[60px] md:py-[120px] bg-white">
    <div class="xl:container px-6">
      <h2 class="text-[24px] sm:text-[28px] md:text-[31px] font-medium text-content-text text-center mb-10 md:mb-14">Frequently Asked Questions</h2>
      <FAQ faqs={faqs} client:load />
    </div>
  </section>

  <PlanTable rows={planRows} client:load />

  <RelatedPages links={[
    { href: "/solutions/website-hosting", label: "Website Hosting", description: "Host static sites on a peer-to-peer network" },
    { href: "/solutions/ipfs-pinning", label: "IPFS Pinning", description: "Pin files with permanent, verifiable addresses" },
  ]} />

  <BrandLogos logos={logos} logoType="light" title="Built On" variant="white" client:load />

  <CallToAction
    heading={ctaCopy.hosting.heading}
    subheading={ctaCopy.hosting.subheading}
    primaryLabel="Host a Website →"
    intent="hosting"
    client:load
  />
</Layout>
