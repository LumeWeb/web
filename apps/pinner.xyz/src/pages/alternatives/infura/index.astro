---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import CallToAction from '@/components/CallToAction';
import FAQ from '@/components/FAQ';
import BrandLogos from '@/components/BrandLogos';
import RelatedPages from '@/components/RelatedPages.astro';
import PlanTable from '@/components/PlanTable.astro';
import logos from '@/data/brand-logos';
import { config, ctaCopy } from '@/lib/config';
import { frameworkList } from '@/lib/frameworks';

import ValuesSection from "@/components/HowItWorks/ValuesSection";
import UploadFlowSection from "@/components/HowItWorks/UploadFlowSection";
import DistributionSection from "@/components/HowItWorks/DistributionSection";

const planRows = [
  { factor: "What you pay for", detail: "Storage and bandwidth only" },
  { factor: "Storage layer", detail: "Sia network: hosts prove they're storing your data to get paid" },
  { factor: "Content addressing", detail: "Every file gets a permanent, verifiable hash" },
  { factor: "Payment methods", detail: "Crypto or card. No KYC for crypto." },
  { factor: "IPFS pinning", detail: "Standard CIDs and content addressing" },
  { factor: "Website hosting", detail: "Host static sites from pinned content" },
  { factor: "Open source", detail: "Fully FOSS" },
  { factor: "Data durability", detail: "Your data lives on independent hosts, not one company's servers" },
];

const faqs = [
  {
    question: "I'm migrating from Infura. What do I need?",
    answer: "Your original files and any CIDs you had pinned on Infura. Content addresses (CIDs) come from your file's content, so the same files produce the same CIDs. Pin your existing CIDs on Pinner and they're live. If you used Infura's dedicated gateway URLs, update those to Pinner's endpoints."
  },
  {
    question: "What happened to Infura's IPFS service?",
    answer: "Infura is ending its IPFS service on August 15, 2026. New uploads and pinning stop on August 3. After August 15, Infura's IPFS API and dedicated gateways shut down, and any content you haven't moved goes offline. The shutdown follows earlier restrictions: Infura disabled new key creation in late 2024, introduced a 5 USD monthly minimum in September 2025, and limited access to pre-qualified customers."
  },
  {
    question: "How is Pinner different from Infura?",
    answer: "Pinner stores your data on the Sia network, where independent hosts must cryptographically prove they're storing it to get paid. You also get website hosting from pinned content, crypto payments with no KYC, and fully open source code. Content addresses stay the same, so your existing CIDs work as-is."
  },
  {
    question: "Can I use the same content addresses?",
    answer: "Yes. Content addresses (CIDs) come from your file's content, so they stay the same regardless of provider. The same file pinned on Pinner has the same CID as it did on Infura or any other IPFS service. Pin your existing CIDs on Pinner and they resolve to the same content."
  },
  {
    question: "Can I keep my existing IPNS address?",
    answer: "Yes. If you have your IPNS private key, you can import it into Pinner and continue publishing to the same IPNS address. The address stays the same; only the publishing service changes."
  },
  {
    question: "What kinds of sites work on Pinner?",
    answer: `Static sites: HTML, CSS, and JavaScript. Portfolios, documentation, landing pages, blogs generated by static site generators (${frameworkList({ format: "technical" })}). No server-side rendering or dynamic backends.`
  }
];
---

<Layout title="Infura Alternative: IPFS Pinning After the Shutdown | Pinner" navTheme="dark" description="Infura's IPFS service shuts down August 15, 2026. Move your pins to Pinner. Data stored on the Sia network by independent hosts who are paid to store it.">
  <PageHeader
    title="IPFS pinning on storage that proves itself"
    description="Infura's IPFS service ends August 15, 2026. Your data on Pinner lives on a network of independent hosts paid to keep it."
    btnText="Start Pinning →"
    url={config.registerUrl("pinning")}
    secondaryBtnText="See Pricing →"
    secondaryUrl="/pricing"
    client:load
  />

  <UploadFlowSection
    subtitle="What happened to Infura?"
    title="An IPFS service that's shutting down"
    description="Infura is ending its IPFS service on August 15, 2026. New uploads stop August 3. Content not moved by then will be unavailable through Infura. The shutdown follows earlier restrictions: new key creation disabled in late 2024, a 5 USD monthly minimum since September 2025, and access limited to pre-qualified customers."
    theme="white"
    client:load
  />

  <DistributionSection
    subtitle="Storage"
    title="Your data lives on a network, not our servers"
    description="The Sia network stores your data across independent hosts who are paid to store it and must prove they're doing it. If a host drops off, the network re-replicates to another. Hosts lose money if they lose your data, so they don't. On the serving side, we distribute your content over HTTP and peer-to-peer (IPFS). If our gateway goes down, your site goes down, but your data stays on the network because it doesn't live on our servers."
    theme="gray"
    imagePosition="right"
    client:load
  />

  <ValuesSection
    subtitle="Migration"
    title="Need help moving your pins? We'll help you migrate."
    description="Content addresses (CIDs) come from your file's content, so they stay the same across providers. The same file pinned on Pinner has the same CID as it did on Infura. Pin your existing CIDs and they're live. Before August 15, update any Infura API endpoints, dedicated gateway URLs, hardcoded asset links, and backend environment variables. If you have a large collection, reach out and we'll work with you on the transition."
    theme="white"
    client:load
  />

  <section class="py-[60px] md:py-[120px] bg-white">
    <div class="xl:container px-6">
      <h2 class="text-[24px] sm:text-[28px] md:text-[31px] font-medium text-content-text text-center mb-10 md:mb-14">Frequently Asked Questions</h2>
      <FAQ faqs={faqs} client:load />
    </div>
  </section>

  <PlanTable rows={planRows} client:load />

  <RelatedPages links={[
    { href: "/solutions/ipfs-pinning", label: "IPFS Pinning", description: "Pin files to a peer-to-peer network with permanent links" },
    { href: "/solutions/website-hosting", label: "Website Hosting", description: "Host static sites on a peer-to-peer network" },
  ]} />

  <BrandLogos logos={logos} logoType="light" title="Built On" variant="white" client:load />

  <CallToAction
    heading={ctaCopy.pinning.heading}
    subheading={ctaCopy.pinning.subheading}
    primaryLabel="Start Pinning →"
    intent="pinning"
    client:load
  />
</Layout>
