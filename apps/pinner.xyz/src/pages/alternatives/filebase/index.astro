---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader';
import AboutSection from '@/components/AboutSection';
import CallToAction from '@/components/CallToAction';
import FAQ from '@/components/FAQ';
import BrandLogos from '@/components/BrandLogos';
import RelatedPages from '@/components/RelatedPages.astro';
import PlanTable from '@/components/PlanTable.astro';
import logos from '@/data/brand-logos';
import { config, ctaCopy } from '@/lib/config';
import { frameworkList } from '@/lib/frameworks';

import ValuesSection from "@/components/HowItWorks/ValuesSection";
import UploadFlowSection from "@/components/HowItWorks/UploadFlowSection";
import DistributionSection from "@/components/HowItWorks/DistributionSection";

const planRows = [
  { factor: "What you pay for", detail: "5 USD/mo for 250 GB bandwidth" },
  { factor: "Storage layer", detail: "Sia network: independent hosts prove they're storing your data to get paid" },
  { factor: "Content addressing", detail: "Every file gets a permanent, verifiable hash" },
  { factor: "Payment methods", detail: "Crypto or card. No KYC for crypto." },
  { factor: "Deployment", detail: "Upload your site files and get a live URL" },
  { factor: "Domain support", detail: "Custom domains with SSL, IPNS addresses" },
  { factor: "Open source", detail: "Fully FOSS" },
  { factor: "Product focus", detail: "Static hosting" },
];

const faqs = [
  {
    question: "What does Pinner cost?",
    answer: "5 USD/mo for 250 GB bandwidth with one product and one price. No separate tiers for hosting vs. storage."
  },
  {
    question: "How does deployment work?",
    answer: "Upload your site files (HTML, CSS, JS) and get a live URL. Pinner handles pinning, IPNS, and gateway serving in one step."
  },
  {
    question: "Can I pay with crypto?",
    answer: "Yes. Crypto or card. No KYC required for crypto payments. Pinner is also fully open source so you can inspect the code, run your own instance, or verify how your data is handled."
  },
  {
    question: "Can I use the same content addresses if I switch?",
    answer: "Yes. Content addresses are content hashes, determined by your file's content, not by the provider. The same file pinned on Pinner has the same CID as it did on any other IPFS service. If you have your IPNS private key, you can import it into Pinner and continue publishing to the same IPNS address."
  },
  {
    question: "What kinds of sites work on Pinner?",
    answer: `Static sites: HTML, CSS, and JavaScript. Portfolios, documentation, landing pages, blogs generated by static site generators (${frameworkList({ format: "technical" })}). No server-side rendering or dynamic backends.`
  }
];
---

<Layout title="Filebase Sites Alternative for Static Site Hosting | Pinner" navTheme="dark" description="Static site hosting on the Sia network with crypto payments, no KYC, and open-source code. 5 USD/mo, one product, one price.">
  <PageHeader
    title="Static hosting, one product, one price"
    description="5 USD/mo for 250 GB bandwidth. Crypto or card, no KYC for crypto. Your data lives on a network of independent hosts, not one company's servers."
    btnText="Start Hosting →"
    url={config.registerUrl("hosting")}
    secondaryBtnText="See Pricing →"
    secondaryUrl="/pricing"
    client:load
  />

  <UploadFlowSection
    subtitle="Why Pinner"
    title="Static site hosting you can count on"
    description="Your data lives on the Sia network across independent hosts who are paid to store it and must prove they're doing it. Your data doesn't live on our servers. It lives on a network designed to keep it around. Pinner is built for static hosting and that's the product."
    theme="white"
    client:load
  />

  <DistributionSection
    subtitle="Storage"
    title="Your data lives on a network, not our servers"
    description="Your data is stored on the Sia network, distributed across independent hosts who are paid to store it and must prove they're doing it. If a host drops off, the network re-replicates to another. Hosts lose money if they lose your data, so they don't. On the serving side, we distribute your site over HTTP and peer-to-peer (IPFS). If our gateway goes down, your site goes down, but your data stays on the network because it doesn't live on our servers."
    theme="gray"
    imagePosition="right"
    client:load
  />

<ValuesSection
  subtitle="Getting Started"
  title="Deploy your static site"
  description="Upload your site files (HTML, CSS, JS) and get a live URL. Static sites, portfolios, documentation sites, and dApps all work. No server-side rendering or dynamic backends."
  theme="white"
  client:load
/>

  <section class="py-[60px] md:py-[120px] bg-white">
    <div class="xl:container px-6">
      <h2 class="text-[24px] sm:text-[28px] md:text-[31px] font-medium text-content-text text-center mb-10 md:mb-14">Frequently Asked Questions</h2>
      <FAQ faqs={faqs} client:load />
    </div>
  </section>

  <PlanTable rows={planRows} client:load />

  <RelatedPages links={[
    { href: "/solutions/website-hosting", label: "Website Hosting", description: "Host static sites on a peer-to-peer network" },
    { href: "/solutions/ipfs-pinning", label: "IPFS Pinning", description: "Pin files with permanent, verifiable addresses" },
  ]} />

  <BrandLogos logos={logos} logoType="light" title="Built On" variant="white" client:load />

  <CallToAction
    heading={ctaCopy.hosting.heading}
    subheading={ctaCopy.hosting.subheading}
    primaryLabel="Host a Website →"
    intent="hosting"
    client:load
  />
</Layout>
