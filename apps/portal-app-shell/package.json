{
  "name": "@lumeweb/portal-app-shell",
  "version": "0.2.4",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm run start",
    "start": "vite --mode production",
    "build": "run-s build:dashboard",
    "build:dashboard": "dotenv -e .env.dashboard -- pnpm build:dashboard:build",
    "build:dashboard:build": "NODE_ENV=development vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@lumeweb/portal-framework-core": "workspace:*",
    "@lumeweb/portal-framework-ui": "workspace:*",
    "@lumeweb/portal-framework-ui-core": "workspace:*",
    "@lumeweb/portal-sdk": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-query": "^5.90.12",
    "events": "^3.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "7.54.0",
    "react-router": "^7.10.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.93.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
