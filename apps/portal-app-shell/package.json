{
  "name": "@lumeweb/portal-app-shell",
  "version": "0.3.6",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm run start",
    "start": "vite --mode production",
    "build": "run-s build:dashboard",
    "build:dashboard": "dotenv -e .env.dashboard -- pnpm build:build",
    "build:admin": "dotenv -e .env.admin -- pnpm build:build",
    "build:build": "NODE_ENV=development vite build",
    "serve": "run-s serve:dashboard",
    "serve:dashboard": "dotenv -e .env.dashboard -- vite preview",
    "serve:admin": "dotenv -e .env.admin -- vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@lumeweb/advanced-rest-provider": "workspace:",
    "@lumeweb/analytics": "workspace:",
    "@lumeweb/portal-framework-core": "workspace:*",
    "@lumeweb/portal-framework-ui": "workspace:*",
    "@lumeweb/portal-framework-ui-core": "workspace:*",
    "@lumeweb/portal-sdk": "workspace:*",
    "@refinedev/core": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "dotenv-cli": "catalog:",
    "npm-run-all": "catalog:",
    "sass-embedded": "^1.100.0",
    "vite": "catalog:framework"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}