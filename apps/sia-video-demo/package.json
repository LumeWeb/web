{
  "name": "@lumeweb/sia-video-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "preview": "vite preview",
    "preview:debug": "vite preview --mode debug --port 4181 --strictPort",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --config vitest.config.unit.ts",
    "lint": "oxlint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e:mock": "pnpm --filter @lumeweb/tsdown-config build:config && pnpm --filter @lumeweb/sia-session build && pnpm --filter @lumeweb/sia-app-access build && pnpm --filter @lumeweb/sia-testing build && pnpm --filter @lumeweb/sia-video-source build && playwright test --config playwright.mock.config.ts",
    "test:e2e:mock:build": "vite build --config tests/playback/vite.config.ts",
    "test:e2e:mock:collect": "pnpm --filter @lumeweb/tsdown-config build:config && pnpm --filter @lumeweb/sia-session build && pnpm --filter @lumeweb/sia-app-access build && pnpm --filter @lumeweb/sia-testing build && playwright test --config playwright.mock.config.ts --list"
  },
  "dependencies": {
    "@lumeweb/sia-app-access": "workspace:*",
    "@lumeweb/sia-video-source": "workspace:*",
    "@siafoundation/sia-storage": "0.2.0",
    "@videojs/core": "10.0.0-beta.32",
    "@videojs/media": "10.0.0-beta.32",
    "@videojs/react": "10.0.0-beta.32",
    "@videojs/spf": "10.0.0-beta.32",
    "@videojs/store": "10.0.0-beta.32",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:websites",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "catalog:",
    "vite": "catalog:framework",
    "vitest": "catalog:",
    "@lumeweb/sia-testing": "workspace:*",
    "@playwright/test": "^1.61.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LumeWeb/web"
  }
}
