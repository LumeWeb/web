---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Home/Hero";
import Account from "@/components/Home/Account";
import RailsSection from "@/components/Home/RailsSection";
import TrustSection from "@/components/Home/TrustSection";
import BrandLogos from "@/components/BrandLogos";
import PricingTable from "@/components/Home/PricingTable";
import Blog from "@/components/Home/Blog";
import CallToAction from "@/components/CallToAction";
import logos from "@/data/brand-logos";
---

<Layout title="Home" variant="home">
  <Hero client:load />

  <Account client:load variant="dark" />

  <RailsSection client:load />

  <TrustSection client:load variant="dark" />

  <BrandLogos
    logos={logos}
    logoType="dark"
    title="Powered & Trusted by"
    variant="dark"
    client:load
  />

  <PricingTable client:load />

  <CallToAction client:load variant="dark" />

  <!--<Blog client:load />-->
</Layout>
