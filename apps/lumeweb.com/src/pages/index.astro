---
import Layout from "@/layouts/Layout.astro";
import { HomepageHero } from "@/components/hero";
import { Services } from "@/components/home/services";
import { Community } from "@/components/home/community";
import { PoweredBy } from "@/components/home/powered-by";
import { Message } from "@/components/home/message";
import { getCollection } from "astro:content";
import { findSocialById, extractCollectionData } from "@/data/parsers";
import heroBg from "@/assets/hero-background.png";

const services = await getCollection("services");
const communityProjects = await getCollection("community");
const socials = await getCollection("socials");
const discordUrl = findSocialById(socials, "discord");
---

<Layout title="Lume Web - Your Open Web">
  <HomepageHero
    client:load
    backgroundImage={heroBg.src}
    blur="xs"
    opacity="100"
    buttons={[
      { label: "Explore Ecosystem", url: "/projects", variant: "primary" },
      { label: "Join Community", url: discordUrl, variant: "secondary" },
    ]}
  />
  <Services client:load services={extractCollectionData(services)} />
  <PoweredBy client:load />
  <Community client:load socials={extractCollectionData(socials)} projects={extractCollectionData(communityProjects)} />
  <Message client:load />
</Layout>
