---
import Layout from "@/layouts/Layout.astro";
import { Donate } from "@/components/donate/donate";
import { getCollection } from "astro:content";
import { getContactEmail } from "@/data/collections";

const cryptoCurrencies = await getCollection("cryptoCurrencies");
const fiatPlatforms = await getCollection("fiatPlatforms");

const contactEmail = await getContactEmail();
---

<Layout view="donate" title="Donate - Lume Web">
  <Donate
    client:load
    cryptoCurrencies={cryptoCurrencies.map(c => c.data)}
    fiatPlatforms={fiatPlatforms.map(p => p.data)}
    contactEmail={contactEmail}
  />
</Layout>