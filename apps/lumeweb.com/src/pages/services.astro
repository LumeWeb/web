---
import Layout from "@/layouts/Layout.astro";
import { Hero, HeroContent } from "@/components/hero";
import { getCollection } from "astro:content";
import heroBg3 from "@/assets/hero-bg-3.png";

const services = await getCollection("services");
const upcomingServices = null;

const { getContactEmail } = await import("@/data/collections");
const contactEmail = await getContactEmail();
---

<Layout title="Services - Lume Web">
  <Hero client:load backgroundImage={heroBg3.src} minHeight="sm" bgPosition="auto">
    <HeroContent
      title="Our Services"
      titleSize="md"
      buttons={[]}
    />
  </Hero>

  <section class="py-24 px-6 bg-blue-charcoal">
    <div class="max-w-6xl mx-auto">
      <div class="space-y-12">
        {services.map((entry) => {
          const service = entry.data;
          return (
          <div class="bg-blue-charcoal-2 border border-aquamarine/20 rounded-xl p-8">
            <div class="flex flex-col md:flex-row gap-6">
              <div class="flex-1">
                <h3 class="font-display text-2xl font-bold text-aquamarine mb-4">
                  {service.name}
                </h3>
                <p class="font-body text-lg text-cloud mb-4">
                  {service.description}
                </p>
                <p class="font-body text-cloud mb-4">
                  <strong class="text-white">What you get:</strong>
                </p>
                <ul class="font-body text-cloud space-y-2 mb-6">
                  {service.features.map((feature) => (
                    <li>• {feature}</li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-4">
                  {service.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        "inline-flex items-center px-6 py-3 font-display font-bold rounded-lg transition-colors duration-250",
                        link.style === "primary"
                          ? "bg-aquamarine text-blue-charcoal hover:bg-white"
                          : "border-2 border-aquamarine text-aquamarine hover:bg-aquamarine/10"
                      ]}
                    >
                      {link.text}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          );
        })}

        <!-- Upcoming Services -->
        {upcomingServices && (
          <div class="bg-blue-charcoal-2 border border-aquamarine/20 rounded-xl p-8">
            <div class="flex flex-col md:flex-row gap-6">
              <div class="flex-1">
                <h3 class="font-display text-2xl font-bold text-aquamarine mb-4">
                  {upcomingServices.tagline}
                </h3>
                <p class="font-body text-lg text-cloud mb-4">
                  {upcomingServices.description}
                </p>
                <p class="font-body text-cloud mb-4">
                  <strong class="text-white">In development:</strong>
                </p>
                <ul class="font-body text-cloud space-y-2 mb-6">
                  {upcomingServices.features.map((feature) => (
                    <li>• {feature}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-8">
        Enterprise Solutions
      </h2>
      <p class="font-body text-xl text-cloud mb-8">
        Need custom decentralized infrastructure for your organization? Get in touch.
      </p>
      <a
        href={`mailto:${contactEmail}`}
        class="inline-flex items-center px-8 py-4 bg-aquamarine text-blue-charcoal font-display font-bold text-lg rounded-lg hover:bg-white transition-colors duration-250"
      >
        Contact Us
      </a>
    </div>
  </section>
</Layout>