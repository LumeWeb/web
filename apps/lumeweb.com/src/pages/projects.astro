---
import Layout from "@/layouts/Layout.astro";
import { Hero, HeroContent } from "@/components/hero";
import { getCollection } from "astro:content";
import heroBg3 from "@/assets/hero-bg-3.png";

const communityProjects = await getCollection("community");

const communitySectionsData = await getCollection("communitySections");
const communitySectionsMap = Object.fromEntries(
  communitySectionsData.map(s => [s.data.id, s.data])
);
---

<Layout title="Community Projects - Lume Web" description="Community projects building on Lume Web's open infrastructure. Join developers creating the decentralized web.">
  <Hero client:load backgroundImage={heroBg3.src} minHeight="sm" bgPosition="auto">
    <HeroContent
      title="Community Projects"
      tagline="Free and open source tools we build for the public good. Supported by our services revenue."
      titleSize="md"
      buttons={[]}
    />
  </Hero>

  <section class="py-24 px-6 bg-blue-charcoal">
    <div class="max-w-6xl mx-auto">
      <div class="space-y-12">
        {communityProjects.map((entry) => {
          const project = entry.data;
          return (
          <div class="bg-blue-charcoal-2 border border-aquamarine/20 rounded-xl p-8">
            <div class="flex flex-col md:flex-row gap-6">
              <div class="flex-1">
                <h3 class="font-display text-2xl font-bold text-aquamarine mb-4">
                  {project.name}
                </h3>
                <p class="font-body text-lg text-cloud mb-4">
                  {project.description}
                </p>
                <p class="font-body text-cloud mb-4">
                  <strong class="text-white">Includes:</strong>
                </p>
                <ul class="font-body text-cloud space-y-2 mb-6">
                  {project.features.map((feature) => (
                    <li>• {feature}</li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-4">
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        "inline-flex items-center px-6 py-3 font-display font-bold rounded-lg transition-colors duration-250",
                        link.style === "primary"
                          ? "bg-aquamarine text-blue-charcoal hover:bg-white"
                          : "border-2 border-aquamarine text-aquamarine hover:bg-aquamarine/10"
                      ]}
                    >
                      {link.text}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-8">
        Contribute
      </h2>
      <p class="font-body text-xl text-cloud mb-8">
        These projects are maintained by us and the community. Bug reports, feature requests, and pull requests are welcome.
      </p>
      <a
        href={communitySectionsMap.github?.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 border-2 border-aquamarine text-aquamarine font-display font-bold text-lg rounded-lg hover:bg-aquamarine/10 transition-colors duration-250"
      >
        {communitySectionsMap.github?.label || "View on GitHub"}
      </a>
    </div>
  </section>
</Layout>
