---
import logo from "@/assets/lume-logo.png";
import { getEntry } from "astro:content";

const currentPath = Astro.url.pathname;
const navigation = await getEntry("navigation", "main");
const navbarItems = navigation.data.navbar;

function getActiveClass(href: string): string {
  if (href.startsWith("http")) return "";
  const linkPath = href.endsWith("/") ? href : href + "/";
  const currentPathWithSlash = currentPath.endsWith("/") ? currentPath : currentPath + "/";
  return currentPathWithSlash === linkPath ? "border-b border-white" : "";
}
---

<nav class="flex flex-row items-center justify-between py-8 px-6 md:p-14">
  <div class="logo">
    <a href="/">
      <img class="w-36 md:w-44" src={logo.src} alt="Lume Logo" />
    </a>
  </div>
  <menu
    class="hidden md:flex flex-row items-center gap-8 lg:gap-12 z-20"
  >
    {navbarItems.map((item) => (
      <li>
        <a
          href={item.href}
          class={getActiveClass(item.href)}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          {item.label}
          {item.external && " ↗"}
        </a>
      </li>
    ))}
  </menu>
  <button id="hamburger" class="z-30 text-4xl md:hidden">
    <svg
      width="24"
      height="24"
      viewBox="0 0 52 43"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M1 1.06787H51.295"
        stroke="white"
        stroke-width="1.28"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M1 21.5728H51.295"
        stroke="white"
        stroke-width="1.28"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M1 42.0776H51.295"
        stroke="white"
        stroke-width="1.28"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <div
    id="navbar-overlay"
    class="hidden fixed inset-0 bg-black/90 z-10 md:hidden"
  >
  </div>
  <script src="/src/scripts/navbar.js"></script>
</nav>