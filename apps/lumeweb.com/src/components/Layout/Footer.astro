---
import logo from "@/assets/lume-logo.png";
import { getEntry } from "astro:content";
import { getContactEmail } from "@/data/collections";

const contactEmail = await getContactEmail();

const navigation = await getEntry("navigation", "main");
const footerData = navigation.data.footer;
---

<footer
    class="flex flex-col lg:flex-row py-24 font-body max-w-screen px-6 lg:px-12"
>
    <div class="flex-1">
        <a href="/">
            <img src={logo.src} class="w-36 mb-2" alt="Lume"/>
        </a>
        <a
            href={`mailto:${contactEmail}`}
            class="flex flex-row items-center text-body text-xl"
        >
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4 mr-2"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                >
                </path>
            </svg>
            {contactEmail}
        </a>
        <div class="text-lg text-primary font-bold font-display my-10">
            Freedom. Privacy. <br/>Ownership.
        </div>
    </div>
    {footerData.columns.map((column) => (
    <div class="flex-1 my-5 lg:my-0">
        <h3 class="text-3xl mb-3">{column.title}</h3>
        <ul class="text-body font-body text-xl">
            {column.items.map((item) => (
            <li>
                <a
                    href={item.href}
                    class="hover:underline"
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                >
                    {item.label}
                </a>
            </li>
            ))}
        </ul>
    </div>
    ))}
</footer>