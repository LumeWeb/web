From 14b75cd5ed1ce4e73e52c6bc1a172635769e8799 Mon Sep 17 00:00:00 2001
From: Derrick Hammer <derrick@derrickhammer.com>
Date: Tue, 27 Oct 2026 06:47:15 +0000
Subject: [PATCH] Return signed metadata summaries when slabs are excluded

The shared-object listing ignored includeslabs=false, so SDK summary decoders received full objects without an explicit ID or size. Keep the default full-object response and provide a slab-free summary with the canonical object ID and logical byte size when requested.

Preserve sealed metadata and signatures, validate the boolean query, and document the variant in OpenAPI. Handler tests cover independent hash vectors, large sizes, paging, and error statuses. Six source controls were detected. Database-backed regressions remain blocked by the unavailable PostgreSQL fixture.
---
 third_party/indexd/api/app/shared.go          |  12 ++
 .../indexd/api/app/shared_summary_test.go     | 178 ++++++++++++++++++
 third_party/indexd/openapi/app.yml            |  16 +-
 third_party/indexd/openapi/components.yml     |  40 ++++
 third_party/indexd/slabs/summary.go           |  34 ++++
 5 files changed, 278 insertions(+), 2 deletions(-)
 create mode 100644 third_party/indexd/api/app/shared_summary_test.go
 create mode 100644 third_party/indexd/slabs/summary.go

diff --git a/third_party/indexd/api/app/shared.go b/third_party/indexd/api/app/shared.go
index 76caa94..9a08dfd 100644
--- a/third_party/indexd/api/app/shared.go
+++ b/third_party/indexd/api/app/shared.go
@@ -25,6 +25,10 @@ func (a *app) handleGETShared(jc jape.Context, key sharing.Key) {
 }
 
 func (a *app) handleGETSharedObjects(jc jape.Context, key sharing.Key) {
+	includeSlabs := true
+	if jc.DecodeForm("includeslabs", &includeSlabs) != nil {
+		return
+	}
 	offset, limit, ok := api.ParseOffsetLimit(jc)
 	if !ok {
 		return
@@ -37,6 +41,14 @@ func (a *app) handleGETSharedObjects(jc jape.Context, key sharing.Key) {
 	} else if jc.Check("failed to list shared objects", err) != nil {
 		return
 	}
+	if !includeSlabs {
+		summaries := make([]slabs.SealedObjectSummary, len(objects))
+		for i := range objects {
+			summaries[i] = objects[i].Summary()
+		}
+		jc.Encode(summaries)
+		return
+	}
 	jc.Encode(objects)
 }
 
diff --git a/third_party/indexd/api/app/shared_summary_test.go b/third_party/indexd/api/app/shared_summary_test.go
new file mode 100644
index 0000000..d7dc877
--- /dev/null
+++ b/third_party/indexd/api/app/shared_summary_test.go
@@ -0,0 +1,178 @@
+package app
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"go.sia.tech/core/types"
+	"go.sia.tech/indexd/sharing"
+	"go.sia.tech/indexd/slabs"
+	"go.sia.tech/jape"
+)
+
+// These handler fixtures test JSON encoding, not account authentication or host storage.
+type summarySharingFixture struct {
+	Sharing
+	objects []slabs.SealedObject
+	err     error
+}
+
+func (s summarySharingFixture) SharedObjects(_ types.PublicKey, offset, limit int) ([]slabs.SealedObject, error) {
+	if s.err != nil {
+		return nil, s.err
+	} else if offset >= len(s.objects) {
+		return nil, nil
+	}
+	return s.objects[offset:min(offset+limit, len(s.objects))], nil
+}
+
+func summaryObject() slabs.SealedObject {
+	slab := slabs.SlabSlice{EncryptionKey: slabs.EncryptionKey{1}, MinShards: 1, Sectors: []slabs.PinnedSector{{Root: types.Hash256{2}}}, Length: 5}
+	second := slab
+	second.Offset, second.Length = 2, 7
+	obj := slabs.SealedObject{
+		EncryptedDataKey: []byte{1, 2, 3}, EncryptedMetadataKey: []byte{4, 5}, EncryptedMetadata: []byte{6, 7},
+		Slabs: []slabs.SlabSlice{slab, second}, CreatedAt: time.Unix(1700000000, 0).UTC(), UpdatedAt: time.Unix(1700000005, 0).UTC(),
+	}
+	obj.Sign(types.NewPrivateKeyFromSeed(make([]byte, 32)))
+	return obj
+}
+
+func summaryResponse(query string, objects []slabs.SealedObject, err error) *httptest.ResponseRecorder {
+	a := &app{sharing: summarySharingFixture{objects: objects, err: err}}
+	mux := jape.Mux(map[string]jape.Handler{
+		"GET /shared/objects": func(jc jape.Context) { a.handleGETSharedObjects(jc, sharing.Key{}) },
+	})
+	response := httptest.NewRecorder()
+	mux.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/shared/objects"+query, nil))
+	return response
+}
+
+func TestSharedObjectSummaries(t *testing.T) {
+	for _, query := range []string{"", "?includeslabs=true", "?includeslabs=false"} {
+		t.Run(query, func(t *testing.T) {
+			response := summaryResponse(query, []slabs.SealedObject{summaryObject()}, nil)
+			if response.Code != http.StatusOK {
+				t.Fatal(response.Code, response.Body.String())
+			}
+			var rows []map[string]json.RawMessage
+			if err := json.Unmarshal(response.Body.Bytes(), &rows); err != nil {
+				t.Fatal(err)
+			} else if len(rows) != 1 {
+				t.Fatalf("expected one object, got %d", len(rows))
+			}
+			_, hasSlabs := rows[0]["slabs"]
+			if query != "?includeslabs=false" {
+				if !hasSlabs || rows[0]["objectID"] != nil || rows[0]["size"] != nil {
+					t.Fatal("full-object response changed", response.Body.String())
+				}
+				return
+			} else if hasSlabs {
+				t.Fatal("summary contains slabs", response.Body.String())
+			}
+			for field, want := range map[string]string{
+				"objectID": `"d1e7fef2c6438d850dab0fcc3ee0fe6fe54224226856bca399c903ad43387b74"`,
+				"size":     "12", "encryptedDataKey": `"AQID"`, "encryptedMetadataKey": `"BAU="`, "encryptedMetadata": `"Bgc="`,
+				"createdAt": `"2023-11-14T22:13:20Z"`, "updatedAt": `"2023-11-14T22:13:25Z"`,
+			} {
+				if string(rows[0][field]) != want {
+					t.Fatalf("%s: expected %s, got %s", field, want, rows[0][field])
+				}
+			}
+			// Using ObjectID or MetaSigHash for these digests would let a hashing
+			// bug supply both the signature input and its expected value.
+			for field, digest := range map[string]string{
+				"metadataSignature": "f53dcf43231fbe5755f2e1c07766cb7befde18e06a7fc2cb70d7bcff61750dd0",
+				"dataSignature":     "0fed4fa7ec30175b0d1823068830bc4f5998b76be1fa4a606a08b6cc8d19a49c",
+			} {
+				var signature types.Signature
+				if err := json.Unmarshal(rows[0][field], &signature); err != nil {
+					t.Fatal(err)
+				}
+				var hash types.Hash256
+				if err := hash.UnmarshalText([]byte(digest)); err != nil {
+					t.Fatal(err)
+				}
+				if !types.NewPrivateKeyFromSeed(make([]byte, 32)).PublicKey().VerifyHash(hash, signature) {
+					t.Fatalf("summary changed %s", field)
+				}
+			}
+		})
+	}
+}
+
+func TestSharedObjectSummaryPages(t *testing.T) {
+	second := summaryObject()
+	second.Slabs = second.Slabs[1:]
+	second.Sign(types.NewPrivateKeyFromSeed(make([]byte, 32)))
+	for _, tc := range []struct {
+		name, query string
+		objects     []slabs.SealedObject
+		want        int
+	}{
+		{"second page", "?includeslabs=false&offset=1&limit=1", []slabs.SealedObject{summaryObject(), second}, 1},
+		{"exhausted", "?includeslabs=false&offset=1&limit=1", []slabs.SealedObject{summaryObject()}, 0},
+		{"empty", "?includeslabs=false", nil, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			response := summaryResponse(tc.query, tc.objects, nil)
+			if response.Code != http.StatusOK {
+				t.Fatal(response.Code, response.Body.String())
+			}
+			var rows []map[string]json.RawMessage
+			if err := json.Unmarshal(response.Body.Bytes(), &rows); err != nil {
+				t.Fatal(err)
+			} else if len(rows) != tc.want || rows == nil {
+				t.Fatal("unexpected summary page", response.Body.String())
+			}
+			if tc.want == 1 && string(rows[0]["size"]) != "7" {
+				t.Fatal("offset did not select the second summary", response.Body.String())
+			}
+		})
+	}
+}
+
+func TestSharedObjectSummaryLargeSize(t *testing.T) {
+	obj := summaryObject()
+	slab := obj.Slabs[0]
+	slab.Length = 4 << 20
+	obj.Slabs = make([]slabs.SlabSlice, 1025)
+	for i := range obj.Slabs {
+		obj.Slabs[i] = slab
+	}
+	obj.Sign(types.NewPrivateKeyFromSeed(make([]byte, 32)))
+	response := summaryResponse("?includeslabs=false", []slabs.SealedObject{obj}, nil)
+	var rows []map[string]json.RawMessage
+	if err := json.Unmarshal(response.Body.Bytes(), &rows); err != nil {
+		t.Fatal(err)
+	} else if response.Code != http.StatusOK || len(rows) != 1 || string(rows[0]["size"]) != "4299161600" {
+		t.Fatal("summary truncated a size above 32 bits", response.Body.String())
+	}
+}
+
+func TestSharedObjectSummaryBadQuery(t *testing.T) {
+	for _, query := range []string{"?includeslabs=invalid", "?includeslabs=false&offset=-1", "?includeslabs=false&limit=-1"} {
+		t.Run(query, func(t *testing.T) {
+			response := summaryResponse(query, nil, errors.New("invalid query reached storage"))
+			if response.Code != http.StatusBadRequest {
+				t.Fatal("expected bad request", response.Code, response.Body.String())
+			}
+		})
+	}
+}
+
+func TestSharedObjectSummaryStoreErrors(t *testing.T) {
+	for _, tc := range []struct {
+		err    error
+		status int
+	}{{sharing.ErrSharingKeyNotFound, http.StatusUnauthorized}, {errors.New("store failed"), http.StatusInternalServerError}} {
+		response := summaryResponse("?includeslabs=false", nil, tc.err)
+		if response.Code != tc.status {
+			t.Fatal("unexpected error status", response.Code, response.Body.String())
+		}
+	}
+}
