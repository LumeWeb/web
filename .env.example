# Example root .env configuration
# Copy this file to .env and fill in your values
# .env is gitignored - put secrets and user-specific settings here

# --- Piko / Tunnel Infrastructure (required) ---
TUNNEL_DOMAIN=dash.lumeweb.com
PIKO_SERVICE=wss://piko.liberty731.com
PIKO_SECRET=your-piko-secret-here

# --- User-Specific Plugin Selection (optional) ---
# Define here to avoid modifying git-tracked .env.tunnel files
# Comma-separated list of plugins to start in multi-app mode
# Examples:
# TUNNEL_PLUGINS=core,dashboard,admin,ipfs,lbry          # All plugins
# TUNNEL_PLUGINS=dashboard                               # Docs mode (single plugin)
# TUNNEL_PLUGINS=core,dashboard                          # Dev mode (minimal)
#
# Precedence:
#   1. CLI: --plugins core,dashboard
#   2. Root .env: TUNNEL_PLUGINS (this file - preferred, gitignored)
#   3. .env.tunnel: TUNNEL_PLUGINS (fallback, git-tracked)
#